{
  "name": "manara-workspace",
  "private": true,
  "version": "1.0.0",
  "description": "Manāra web and native applications",
  "workspaces": [
    "Mishkah"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "web:build": "npm run build",
    "web:preview": "vite preview",
    "mobile": "npm run start --workspace=mishkah",
    "mobile:web": "npm run web --workspace=mishkah",
    "mobile:web:build": "npm run build:web --workspace=mishkah",
    "typecheck:web": "tsc --noEmit",
    "typecheck:mobile": "npm run typecheck --workspace=mishkah",
    "test:mobile": "npm run test --workspace=mishkah",
    "audit": "node scripts/audit.mjs",
    "verify:web": "npm run typecheck:web && npm run audit",
    "verify:mobile": "npm run typecheck:mobile && npm run test:mobile",
    "verify": "npm run verify:web && npm run verify:mobile"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.16",
    "@noble/ciphers": "^2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@reduxjs/toolkit": "^2.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-virtual": "^3.14.13",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "expo": "~58.0.23",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.11",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-haptics": "~58.0.7",
    "expo-location": "~58.0.20",
    "expo-notifications": "~58.1.8",
    "expo-secure-store": "~58.0.2",
    "expo-sensors": "~58.0.4",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "firebase": "^13.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-view-shot": "6.1.1",
    "react-native-web": "^0.21.4",
    "react-redux": "^9.1.2",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.1",
    "workbox-build": "^7.4.1"
  }
}
