{
  "name": "furqan-quran",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Furqan Quran — read, listen and learn the Qur'an: reader, custom multi-surah playlists, audio player, sayings & quotes, progress tracking.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "verify:pwa": "node scripts/verify-pwa.mjs",
    "preview": "vite preview",
    "data:fetch": "node scripts/fetch-quran.mjs && node scripts/normalize-basmala.mjs",
    "data:fetch-indopak": "node scripts/fetch-indopak.mjs",
    "data:timing": "node scripts/fetch-audio-timing.mjs",
    "data:fonts": "node scripts/fetch-fonts.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "setup:assets": "node scripts/generate-icons.mjs && node scripts/fetch-fonts.mjs"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.3.0",
    "@tanstack/react-virtual": "^3.14.13",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.1.2",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.1"
  }
}
