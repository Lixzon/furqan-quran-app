{"number":94,"name":"سُورَةُ الشَّرۡحِ","englishName":"Ash-Sharh","englishNameTranslation":"The Consolation","revelationType":"Meccan","numberOfAyahs":8,"hasBasmalaPrefix":false,"ayahs":[{"g":6091,"i":1,"ar":"أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ","tr":"Did We not expand for you, [O Muhammad], your breast?","tl":"Alam nashrah laka sadrak"},{"g":6092,"i":2,"ar":"وَوَضَعْنَا عَنكَ وِزْرَكَ","tr":"And We removed from you your burden","tl":"Wa wa d'ana 'anka wizrak"},{"g":6093,"i":3,"ar":"ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ","tr":"Which had weighed upon your back","tl":"Allazee anqada zahrak"},{"g":6094,"i":4,"ar":"وَرَفَعْنَا لَكَ ذِكْرَكَ","tr":"And raised high for you your repute.","tl":"Wa raf 'ana laka zikrak"},{"g":6095,"i":5,"ar":"فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","tr":"For indeed, with hardship [will be] ease.","tl":"Fa inna ma'al usri yusra"},{"g":6096,"i":6,"ar":"إِنَّ مَعَ ٱلْعُسْرِ يُسْرًۭا","tr":"Indeed, with hardship [will be] ease.","tl":"Inna ma'al 'usri yusra"},{"g":6097,"i":7,"ar":"فَإِذَا فَرَغْتَ فَٱنصَبْ","tr":"So when you have finished [your duties], then stand up [for worship].","tl":"Fa iza faragh ta fansab"},{"g":6098,"i":8,"ar":"وَإِلَىٰ رَبِّكَ فَٱرْغَب","tr":"And to your Lord direct [your] longing.","tl":"Wa ilaa rabbika far ghab"}]}