{"number":109,"name":"سُورَةُ الكَافِرُونَ","englishName":"Al-Kaafiroon","englishNameTranslation":"The Disbelievers","revelationType":"Meccan","numberOfAyahs":6,"hasBasmalaPrefix":false,"ayahs":[{"g":6208,"i":1,"ar":"قُلْ يَٰٓأَيُّهَا ٱلْكَٰفِرُونَ","tr":"Say, \"O disbelievers,","tl":"Qul yaa-ai yuhal kaafiroon"},{"g":6209,"i":2,"ar":"لَآ أَعْبُدُ مَا تَعْبُدُونَ","tr":"I do not worship what you worship.","tl":"Laa a'budu ma t'abudoon"},{"g":6210,"i":3,"ar":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","tr":"Nor are you worshippers of what I worship.","tl":"Wa laa antum 'aabidoona maa a'bud"},{"g":6211,"i":4,"ar":"وَلَآ أَنَا۠ عَابِدٌۭ مَّا عَبَدتُّمْ","tr":"Nor will I be a worshipper of what you worship.","tl":"Wa laa ana 'abidum maa 'abattum"},{"g":6212,"i":5,"ar":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","tr":"Nor will you be worshippers of what I worship.","tl":"Wa laa antum 'aabidoona ma a'bud"},{"g":6213,"i":6,"ar":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ","tr":"For you is your religion, and for me is my religion.\"","tl":"Lakum deenukum wa liya deen."}]}