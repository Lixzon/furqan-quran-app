{"number":114,"name":"سُورَةُ النَّاسِ","englishName":"An-Naas","englishNameTranslation":"Mankind","revelationType":"Meccan","numberOfAyahs":6,"hasBasmalaPrefix":false,"ayahs":[{"g":6231,"i":1,"ar":"قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ","tr":"Say, \"I seek refuge in the Lord of mankind,","tl":"Qul a'uzu birabbin naas"},{"g":6232,"i":2,"ar":"مَلِكِ ٱلنَّاسِ","tr":"The Sovereign of mankind.","tl":"Malikin naas"},{"g":6233,"i":3,"ar":"إِلَٰهِ ٱلنَّاسِ","tr":"The God of mankind,","tl":"Ilaahin naas"},{"g":6234,"i":4,"ar":"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ","tr":"From the evil of the retreating whisperer -","tl":"Min sharril was waasil khannaas"},{"g":6235,"i":5,"ar":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ","tr":"Who whispers [evil] into the breasts of mankind -","tl":"Al lazee yuwas wisu fee sudoorin naas"},{"g":6236,"i":6,"ar":"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ","tr":"From among the jinn and mankind.\"","tl":"Minal jinnati wan naas"}]}