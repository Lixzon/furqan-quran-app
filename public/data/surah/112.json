{"number":112,"name":"سُورَةُ الإِخۡلَاصِ","englishName":"Al-Ikhlaas","englishNameTranslation":"Sincerity","revelationType":"Meccan","numberOfAyahs":4,"hasBasmalaPrefix":false,"ayahs":[{"g":6222,"i":1,"ar":"قُلْ هُوَ ٱللَّهُ أَحَدٌ","tr":"Say, \"He is Allah, [who is] One,","tl":"Qul huwal laahu ahad"},{"g":6223,"i":2,"ar":"ٱللَّهُ ٱلصَّمَدُ","tr":"Allah, the Eternal Refuge.","tl":"Allah hus-samad"},{"g":6224,"i":3,"ar":"لَمْ يَلِدْ وَلَمْ يُولَدْ","tr":"He neither begets nor is born,","tl":"Lam yalid wa lam yoolad"},{"g":6225,"i":4,"ar":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","tr":"Nor is there to Him any equivalent.\"","tl":"Wa lam yakul-lahu kufuwan ahad"}]}