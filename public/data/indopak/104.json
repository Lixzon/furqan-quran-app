{"surah":104,"ayahs":[{"ayah":1,"text":"وَيۡلٌ لِّـكُلِّ هُمَزَةٍ لُّمَزَةِ ۙ‏"},{"ayah":2,"text":"اۨلَّذِىۡ جَمَعَ مَالًا وَّعَدَّدَهٗ ۙ‏"},{"ayah":3,"text":"يَحۡسَبُ اَنَّ مَالَهٗۤ اَخۡلَدَهٗ​ ۚ‏"},{"ayah":4,"text":"كَلَّا​ لَيُنۡۢبَذَنَّ فِى الۡحُطَمَةِ  ۖ‏"},{"ayah":5,"text":"وَمَاۤ اَدۡرٰٮكَ مَا الۡحُطَمَةُ ؕ‏"},{"ayah":6,"text":"نَارُ اللّٰهِ الۡمُوۡقَدَةُ ۙ‏"},{"ayah":7,"text":"الَّتِىۡ تَطَّلِعُ عَلَى الۡاَفۡـــِٕدَةِ ؕ‏"},{"ayah":8,"text":"اِنَّهَا عَلَيۡهِمۡ مُّؤۡصَدَةٌ ۙ‏"},{"ayah":9,"text":"فِىۡ عَمَدٍ مُّمَدَّدَةٍ‏"}]}