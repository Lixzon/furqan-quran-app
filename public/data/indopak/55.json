{"surah":55,"ayahs":[{"ayah":1,"text":"اَلرَّحۡمٰنُۙ‏"},{"ayah":2,"text":"عَلَّمَ الۡقُرۡاٰنَؕ‏"},{"ayah":3,"text":"خَلَقَ الۡاِنۡسَانَۙ‏"},{"ayah":4,"text":"عَلَّمَهُ الۡبَيَانَ‏"},{"ayah":5,"text":"اَلشَّمۡسُ وَالۡقَمَرُ بِحُسۡبَانٍ‏"},{"ayah":6,"text":"وَّالنَّجۡمُ وَالشَّجَرُ يَسۡجُدٰنِ‏"},{"ayah":7,"text":"وَالسَّمَآءَ رَفَعَهَا وَوَضَعَ الۡمِيۡزَانَۙ‏"},{"ayah":8,"text":"اَلَّا تَطۡغَوۡا فِى الۡمِيۡزَانِ‏"},{"ayah":9,"text":"وَاَقِيۡمُوا الۡوَزۡنَ بِالۡقِسۡطِ وَلَا تُخۡسِرُوا الۡمِيۡزَانَ‏"},{"ayah":10,"text":"وَالۡاَرۡضَ وَضَعَهَا لِلۡاَنَامِۙ‏"},{"ayah":11,"text":"فِيۡهَا فَاكِهَةٌ  ۙ وَّالنَّخۡلُ ذَاتُ الۡاَكۡمَامِ​ ۖ‏"},{"ayah":12,"text":"وَالۡحَبُّ ذُو الۡعَصۡفِ وَالرَّيۡحَانُ​ۚ‏"},{"ayah":13,"text":"فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ‏"},{"ayah":14,"text":"خَلَقَ الۡاِنۡسَانَ مِنۡ صَلۡصَالٍ كَالۡفَخَّارِۙ‏"},{"ayah":15,"text":"وَخَلَقَ الۡجَآنَّ مِنۡ مَّارِجٍ مِّنۡ نَّارٍ​ۚ‏"},{"ayah":16,"text":"فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ‏"},{"ayah":17,"text":"رَبُّ الۡمَشۡرِقَيۡنِ وَ رَبُّ الۡمَغۡرِبَيۡنِ​ۚ‏"},{"ayah":18,"text":"فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ‏"},{"ayah":19,"text":"مَرَجَ الۡبَحۡرَيۡنِ يَلۡتَقِيٰنِۙ‏"},{"ayah":20,"text":"بَيۡنَهُمَا بَرۡزَخٌ لَّا يَبۡغِيٰنِ​ۚ‏"},{"ayah":21,"text":"فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ‏"},{"ayah":22,"text":"يَخۡرُجُ مِنۡهُمَا اللُّـؤۡلُـؤُ وَالۡمَرۡجَانُ​ۚ‏"},{"ayah":23,"text":"فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ‏"},{"ayah":24,"text":"وَلَهُ الۡجَوَارِ الۡمُنۡشَئٰتُ فِى الۡبَحۡرِ كَالۡاَعۡلَامِ​ۚ‏"},{"ayah":25,"text":"فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ‏"},{"ayah":26,"text":"كُلُّ مَنۡ عَلَيۡهَا فَانٍ​ ۚ​ ۖ‏"},{"ayah":27,"text":"وَّيَبۡقٰى وَجۡهُ رَبِّكَ ذُو الۡجَلٰلِ وَالۡاِكۡرَامِ​ۚ‏"},{"ayah":28,"text":"فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ‏"},{"ayah":29,"text":"يَسۡـَٔـلُهٗ مَنۡ فِى السَّمٰوٰتِ وَالۡاَرۡضِ​ؕ كُلَّ يَوۡمٍ هُوَ فِىۡ شَاۡنٍ​ۚ‏"},{"ayah":30,"text":"فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ‏"},{"ayah":31,"text":"سَنَفۡرُغُ لَـكُمۡ اَيُّهَ الثَّقَلٰنِ​ۚ‏"},{"ayah":32,"text":"فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ‏"},{"ayah":33,"text":"يٰمَعۡشَرَ الۡجِنِّ وَالۡاِنۡسِ اِنِ اسۡتَطَعۡتُمۡ اَنۡ تَنۡفُذُوۡا مِنۡ اَقۡطَارِ السَّمٰوٰتِ وَالۡاَرۡضِ فَانْفُذُوۡا​ؕ لَا تَنۡفُذُوۡنَ اِلَّا بِسُلۡطٰنٍ​ۚ‏"},{"ayah":34,"text":"فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ‏"},{"ayah":35,"text":"يُرۡسَلُ عَلَيۡكُمَا شُوَاظٌ مِّنۡ نَّارٍ ۙ وَّنُحَاسٌ فَلَا تَنۡتَصِرٰنِ​ۚ‏"},{"ayah":36,"text":"فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ‏"},{"ayah":37,"text":"فَاِذَا انْشَقَّتِ السَّمَآءُ فَكَانَتۡ وَرۡدَةً كَالدِّهَانِ​ۚ‏"},{"ayah":38,"text":"فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ‏"},{"ayah":39,"text":"فَيَوۡمَٮِٕذٍ لَّا يُسۡـَٔـلُ عَنۡ ذَنۡۢبِهٖۤ اِنۡسٌ وَّلَا جَآنٌّ​ۚ‏"},{"ayah":40,"text":"فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ‏"},{"ayah":41,"text":"يُعۡرَفُ الۡمُجۡرِمُوۡنَ بِسِيۡمٰهُمۡ فَيُؤۡخَذُ بِالنَّوَاصِىۡ وَ الۡاَقۡدَامِ​ۚ‏"},{"ayah":42,"text":"فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ‏"},{"ayah":43,"text":"هٰذِهٖ جَهَنَّمُ الَّتِىۡ يُكَذِّبُ بِهَا الۡمُجۡرِمُوۡنَ​ۘ‏"},{"ayah":44,"text":"يَطُوۡفُوۡنَ بَيۡنَهَا وَبَيۡنَ حَمِيۡمٍ اٰنٍ​ۚ‏"},{"ayah":45,"text":"فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ‏"},{"ayah":46,"text":"وَلِمَنۡ خَافَ مَقَامَ رَبِّهٖ جَنَّتٰنِ​ۚ‏"},{"ayah":47,"text":"فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِۙ‏"},{"ayah":48,"text":"ذَوَاتَاۤ اَفۡنَانٍ​ۚ‏"},{"ayah":49,"text":"فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ‏"},{"ayah":50,"text":"فِيۡهِمَا عَيۡنٰنِ تَجۡرِيٰنِ​ۚ‏"},{"ayah":51,"text":"فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ‏"},{"ayah":52,"text":"فِيۡهِمَا مِنۡ كُلِّ فَاكِهَةٍ زَوۡجٰنِ​ۚ‏"},{"ayah":53,"text":"فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ‏"},{"ayah":54,"text":"مُتَّكِـــِٕيۡنَ عَلٰى فُرُشٍۢ بَطَآٮِٕنُهَا مِنۡ اِسۡتَبۡرَقٍ​ؕ وَجَنَی الۡجَـنَّتَيۡنِ دَانٍ​ۚ‏"},{"ayah":55,"text":"فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ‏"},{"ayah":56,"text":"فِيۡهِنَّ قٰصِرٰتُ الطَّرۡفِۙ لَمۡ يَطۡمِثۡهُنَّ اِنۡسٌ قَبۡلَهُمۡ وَلَا جَآنٌّ​ۚ‏"},{"ayah":57,"text":"فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ ۚ‏"},{"ayah":58,"text":"كَاَنَّهُنَّ الۡيَاقُوۡتُ وَالۡمَرۡجَانُ​ۚ‏"},{"ayah":59,"text":"فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ‏"},{"ayah":60,"text":"هَلۡ جَزَآءُ الْاِحۡسَانِ اِلَّا الۡاِحۡسَانُ​ۚ‏"},{"ayah":61,"text":"فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ‏"},{"ayah":62,"text":"وَمِنۡ دُوۡنِهِمَا جَنَّتٰنِ​ۚ‏"},{"ayah":63,"text":"فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِۙ‏"},{"ayah":64,"text":"مُدۡهَآمَّتٰنِ​ۚ‏"},{"ayah":65,"text":"فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ​ۚ‏"},{"ayah":66,"text":"فِيۡهِمَا عَيۡنٰنِ نَضَّاخَتٰنِ​ۚ‏"},{"ayah":67,"text":"فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ‏"},{"ayah":68,"text":"فِيۡهِمَا فَاكِهَةٌ وَّنَخۡلٌ وَّرُمَّانٌ​ۚ‏"},{"ayah":69,"text":"فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ​ۚ‏"},{"ayah":70,"text":"فِيۡهِنَّ خَيۡرٰتٌ حِسَانٌ​ۚ‏"},{"ayah":71,"text":"فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ​ۚ‏"},{"ayah":72,"text":"حُوۡرٌ مَّقۡصُوۡرٰتٌ فِى الۡخِيَامِ​ۚ‏"},{"ayah":73,"text":"​فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ​ۚ‏"},{"ayah":74,"text":"لَمۡ يَطۡمِثۡهُنَّ اِنۡسٌ قَبۡلَهُمۡ وَلَا جَآنٌّ​ۚ‏"},{"ayah":75,"text":"فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ​ۚ‏"},{"ayah":76,"text":"مُتَّكِــِٕيۡنَ عَلٰى رَفۡرَفٍ خُضۡرٍ وَّعَبۡقَرِىٍّ حِسَانٍ​ۚ‏"},{"ayah":77,"text":"فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ‏"},{"ayah":78,"text":"تَبٰـرَكَ اسۡمُ رَبِّكَ ذِى الۡجَـلٰلِ وَالۡاِكۡرَامِ‏"}]}