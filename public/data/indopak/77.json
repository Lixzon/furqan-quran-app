{"surah":77,"ayahs":[{"ayah":1,"text":"وَالۡمُرۡسَلٰتِ عُرۡفًا ۙ‏"},{"ayah":2,"text":"فَالۡعٰصِفٰتِ عَصۡفًا ۙ‏"},{"ayah":3,"text":"وَّالنّٰشِرٰتِ نَشۡرًا ۙ‏"},{"ayah":4,"text":"فَالۡفٰرِقٰتِ فَرۡقًا ۙ‏"},{"ayah":5,"text":"فَالۡمُلۡقِيٰتِ ذِكۡرًا ۙ‏"},{"ayah":6,"text":"عُذۡرًا اَوۡ نُذۡرًا ۙ‏"},{"ayah":7,"text":"اِنَّمَا تُوۡعَدُوۡنَ لَوَاقِعٌ ؕ‏"},{"ayah":8,"text":"فَاِذَا النُّجُوۡمُ طُمِسَتۡۙ‏"},{"ayah":9,"text":"وَ اِذَا السَّمَآءُ فُرِجَتۡۙ‏"},{"ayah":10,"text":"وَاِذَا الۡجِبَالُ نُسِفَتۡۙ‏"},{"ayah":11,"text":"وَاِذَا الرُّسُلُ اُقِّتَتۡؕ‏"},{"ayah":12,"text":"لِاَىِّ يَوۡمٍ اُجِّلَتۡؕ‏"},{"ayah":13,"text":"لِيَوۡمِ الۡفَصۡلِ​ۚ‏"},{"ayah":14,"text":"وَمَاۤ اَدۡرٰٮكَ مَا يَوۡمُ الۡفَصۡلِؕ‏"},{"ayah":15,"text":"وَيۡلٌ يَّوۡمَٮِٕذٍ لِّلۡمُكَذِّبِيۡنَ‏"},{"ayah":16,"text":"اَلَمۡ نُهۡلِكِ الۡاَوَّلِيۡنَؕ‏"},{"ayah":17,"text":"ثُمَّ نُتۡبِعُهُمُ الۡاٰخِرِيۡنَ‏"},{"ayah":18,"text":"كَذٰلِكَ نَفۡعَلُ بِالۡمُجۡرِمِيۡنَ‏"},{"ayah":19,"text":"وَيۡلٌ يَّوۡمَٮِٕذٍ لِّلۡمُكَذِّبِيۡنَ‏"},{"ayah":20,"text":"اَلَمۡ نَخۡلُقۡكُّمۡ مِّنۡ مَّآءٍ مَّهِيۡنٍۙ‏"},{"ayah":21,"text":"فَجَعَلۡنٰهُ فِىۡ قَرَارٍ مَّكِيۡنٍۙ‏"},{"ayah":22,"text":"اِلٰى قَدَرٍ مَّعۡلُوۡمٍۙ‏"},{"ayah":23,"text":"فَقَدَرۡنَا ۖ فَنِعۡمَ الۡقٰدِرُوۡنَ‏"},{"ayah":24,"text":"وَيۡلٌ يَّوۡمَٮِٕذٍ لِّلۡمُكَذِّبِيۡنَ‏"},{"ayah":25,"text":"اَلَمۡ نَجۡعَلِ الۡاَرۡضَ كِفَاتًا ۙ‏"},{"ayah":26,"text":"اَحۡيَآءً وَّاَمۡوَاتًا ۙ‏"},{"ayah":27,"text":"وَّجَعَلۡنَا فِيۡهَا رَوَاسِىَ شٰمِخٰتٍ وَّ اَسۡقَيۡنٰكُمۡ مَّآءً فُرَاتًا ؕ‏"},{"ayah":28,"text":"وَيۡلٌ يَّوۡمَٮِٕذٍ لِّلۡمُكَذِّبِيۡنَ‏"},{"ayah":29,"text":"اِنْطَلِقُوۡۤا اِلٰى مَا كُنۡتُمۡ بِهٖ تُكَذِّبُوۡنَ​ۚ‏"},{"ayah":30,"text":"اِنْطَلِقُوۡۤا اِلٰى ظِلٍّ ذِىۡ ثَلٰثِ شُعَبٍۙ‏"},{"ayah":31,"text":"لَّا ظَلِيۡلٍ وَّلَا يُغۡنِىۡ مِنَ اللَّهَبِؕ‏"},{"ayah":32,"text":"اِنَّهَا تَرۡمِىۡ بِشَرَرٍ كَالۡقَصۡرِ​ۚ‏"},{"ayah":33,"text":"كَاَنَّهٗ جِمٰلَتٌ صُفۡرٌ ؕ‏"},{"ayah":34,"text":"وَيۡلٌ يَّوۡمَٮِٕذٍ لِّلۡمُكَذِّبِيۡنَ‏"},{"ayah":35,"text":"هٰذَا يَوۡمُ لَا يَنۡطِقُوۡنَۙ‏"},{"ayah":36,"text":"وَلَا يُؤۡذَنُ لَهُمۡ فَيَـعۡتَذِرُوۡنَ‏"},{"ayah":37,"text":"وَيۡلٌ يَّوۡمَٮِٕذٍ لِّلۡمُكَذِّبِيۡنَ‏"},{"ayah":38,"text":"هٰذَا يَوۡمُ الۡفَصۡلِ​ۚ جَمَعۡنٰكُمۡ وَالۡاَوَّلِيۡنَ‏"},{"ayah":39,"text":"فَاِنۡ كَانَ لَـكُمۡ كَيۡدٌ فَكِيۡدُوۡنِ‏"},{"ayah":40,"text":"وَيۡلٌ يَّوۡمَٮِٕذٍ لِّلۡمُكَذِّبِيۡنَ‏"},{"ayah":41,"text":"اِنَّ الۡمُتَّقِيۡنَ فِىۡ ظِلٰلٍ وَّعُيُوۡنٍۙ‏"},{"ayah":42,"text":"وَّفَوَاكِهَ مِمَّا يَشۡتَهُوۡنَؕ‏"},{"ayah":43,"text":"كُلُوۡا وَاشۡرَبُوۡا هَنِيْٓئًا ۢ بِمَا كُنۡتُمۡ تَعۡمَلُوۡنَ‏"},{"ayah":44,"text":"اِنَّا كَذٰلِكَ نَجۡزِى الۡمُحۡسِنِيۡنَ‏"},{"ayah":45,"text":"وَيۡلٌ يَّوۡمَٮِٕذٍ لِّلۡمُكَذِّبِيۡنَ‏"},{"ayah":46,"text":"كُلُوۡا وَتَمَتَّعُوۡا قَلِيۡلًا اِنَّكُمۡ مُّجۡرِمُوۡنَ‏"},{"ayah":47,"text":"وَيۡلٌ يَّوۡمَٮِٕذٍ لِّلۡمُكَذِّبِيۡنَ‏"},{"ayah":48,"text":"وَاِذَا قِيۡلَ لَهُمُ ارۡكَعُوۡا لَا يَرۡكَعُوۡنَ‏"},{"ayah":49,"text":"وَيۡلٌ يَّوۡمَٮِٕذٍ لِّلۡمُكَذِّبِيۡنَ‏"},{"ayah":50,"text":"فَبِاَىِّ حَدِيۡثٍۢ بَعۡدَهٗ يُؤۡمِنُوۡنَ‏"}]}