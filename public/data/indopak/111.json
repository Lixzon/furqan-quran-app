{"surah":111,"ayahs":[{"ayah":1,"text":"تَبَّتۡ يَدَاۤ اَبِىۡ لَهَبٍ وَّتَبَّؕ‏"},{"ayah":2,"text":"مَاۤ اَغۡنٰى عَنۡهُ مَالُهٗ وَمَا كَسَبَؕ‏"},{"ayah":3,"text":"سَيَصۡلٰى نَارًا ذَاتَ لَهَبٍ ۖۚ‏"},{"ayah":4,"text":"وَّامۡرَاَ تُهٗ ؕ حَمَّالَةَ الۡحَطَبِ​ۚ‏"},{"ayah":5,"text":"فِىۡ جِيۡدِهَا حَبۡلٌ مِّنۡ مَّسَدٍ‏"}]}