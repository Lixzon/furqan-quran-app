{"surah":80,"ayahs":[{"ayah":1,"text":"عَبَسَ وَتَوَلّٰٓىۙ‏"},{"ayah":2,"text":"اَنۡ جَآءَهُ الۡاَعۡمٰىؕ‏"},{"ayah":3,"text":"وَمَا يُدۡرِيۡكَ لَعَلَّهٗ يَزَّكّٰٓىۙ‏"},{"ayah":4,"text":"اَوۡ يَذَّكَّرُ فَتَنۡفَعَهُ الذِّكۡرٰىؕ‏"},{"ayah":5,"text":"اَمَّا مَنِ اسۡتَغۡنٰىۙ‏"},{"ayah":6,"text":"فَاَنۡتَ لَهٗ تَصَدّٰىؕ‏"},{"ayah":7,"text":"وَمَا عَلَيۡكَ اَلَّا يَزَّكّٰٓىؕ‏"},{"ayah":8,"text":"وَاَمَّا مَنۡ جَآءَكَ يَسۡعٰىۙ‏"},{"ayah":9,"text":"وَهُوَ يَخۡشٰىۙ‏"},{"ayah":10,"text":"فَاَنۡتَ عَنۡهُ تَلَهّٰى​ۚ‏"},{"ayah":11,"text":"كَلَّاۤ اِنَّهَا تَذۡكِرَةٌ ۚ‏"},{"ayah":12,"text":"فَمَنۡ شَآءَ ذَكَرَهٗ​ۘ‏"},{"ayah":13,"text":"فِىۡ صُحُفٍ مُّكَرَّمَةٍۙ‏"},{"ayah":14,"text":"مَّرۡفُوۡعَةٍ مُّطَهَّرَةٍ ۭۙ‏"},{"ayah":15,"text":"بِاَيۡدِىۡ سَفَرَةٍۙ‏"},{"ayah":16,"text":"كِرَامٍۢ بَرَرَةٍؕ‏"},{"ayah":17,"text":"قُتِلَ الۡاِنۡسَانُ مَاۤ اَكۡفَرَهٗؕ‏"},{"ayah":18,"text":"مِنۡ اَىِّ شَىۡءٍ خَلَقَهٗؕ‏"},{"ayah":19,"text":"مِنۡ نُّطۡفَةٍؕ خَلَقَهٗ فَقَدَّرَهٗ ۙ‏"},{"ayah":20,"text":"ثُمَّ السَّبِيۡلَ يَسَّرَهٗۙ‏"},{"ayah":21,"text":"ثُمَّ اَمَاتَهٗ فَاَقۡبَرَهٗۙ‏"},{"ayah":22,"text":"ثُمَّ اِذَا شَآءَ اَنۡشَرَهٗؕ‏"},{"ayah":23,"text":"كَلَّا لَـمَّا يَقۡضِ مَاۤ اَمَرَهٗؕ‏"},{"ayah":24,"text":"فَلۡيَنۡظُرِ الۡاِنۡسَانُ اِلٰى طَعَامِهٖۤۙ‏"},{"ayah":25,"text":"اَنَّا صَبَبۡنَا الۡمَآءَ صَبًّا ۙ‏"},{"ayah":26,"text":"ثُمَّ شَقَقۡنَا الۡاَرۡضَ شَقًّا ۙ‏"},{"ayah":27,"text":"فَاَنۡۢبَتۡنَا فِيۡهَا حَبًّا ۙ‏"},{"ayah":28,"text":"وَّ عِنَبًا وَّقَضۡبًا ۙ‏"},{"ayah":29,"text":"وَّزَيۡتُوۡنًا وَّنَخۡلًا ؕ‏"},{"ayah":30,"text":"وَحَدَآٮِٕقَ غُلۡبًا ۙ‏"},{"ayah":31,"text":"وَّفَاكِهَةً وَّاَبًّا ۙ‏"},{"ayah":32,"text":"مَّتَاعًا لَّـكُمۡ وَلِاَنۡعَامِكُمۡؕ‏"},{"ayah":33,"text":"فَاِذَا جَآءَتِ الصَّآخَّةُ‏"},{"ayah":34,"text":"يَوۡمَ يَفِرُّ الۡمَرۡءُ مِنۡ اَخِيۡهِۙ‏"},{"ayah":35,"text":"وَاُمِّهٖ وَاَبِيۡهِۙ‏"},{"ayah":36,"text":"وَصَاحِبَتِهٖ وَبَنِيۡهِؕ‏"},{"ayah":37,"text":"لِكُلِّ امۡرِیءٍ مِّنۡهُمۡ يَوۡمَٮِٕذٍ شَاۡنٌ يُّغۡنِيۡهِؕ‏"},{"ayah":38,"text":"وُجُوۡهٌ يَّوۡمَٮِٕذٍ مُّسۡفِرَةٌ ۙ‏"},{"ayah":39,"text":"ضَاحِكَةٌ مُّسۡتَبۡشِرَةٌ ۚ‏"},{"ayah":40,"text":"وَوُجُوۡهٌ يَّوۡمَٮِٕذٍ عَلَيۡهَا غَبَرَةٌ ۙ‏"},{"ayah":41,"text":"تَرۡهَقُهَا قَتَرَةٌ ؕ‏"},{"ayah":42,"text":"اُولٰٓٮِٕكَ هُمُ الۡكَفَرَةُ الۡفَجَرَةُ‏"}]}