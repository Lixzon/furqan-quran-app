{"surah":90,"ayahs":[{"ayah":1,"text":"لَاۤ اُقۡسِمُ بِهٰذَا الۡبَلَدِۙ‏"},{"ayah":2,"text":"وَاَنۡتَ حِلٌّ ۢ بِهٰذَا الۡبَلَدِۙ‏"},{"ayah":3,"text":"وَوَالِدٍ وَّمَا وَلَدَ ۙ‏"},{"ayah":4,"text":"لَقَدۡ خَلَقۡنَا الۡاِنۡسَانَ فِىۡ كَبَدٍؕ‏"},{"ayah":5,"text":"اَيَحۡسَبُ اَنۡ لَّنۡ يَّقۡدِرَ عَلَيۡهِ اَحَدٌ​ ۘ‏"},{"ayah":6,"text":"يَقُوۡلُ اَهۡلَكۡتُ مَالًا لُّبَدًا ؕ‏"},{"ayah":7,"text":"اَيَحۡسَبُ اَنۡ لَّمۡ يَرَهٗۤ اَحَدٌ ؕ‏"},{"ayah":8,"text":"اَلَمۡ نَجۡعَلۡ لَّهٗ عَيۡنَيۡنِۙ‏"},{"ayah":9,"text":"وَلِسَانًا وَّشَفَتَيۡنِۙ‏"},{"ayah":10,"text":"وَهَدَيۡنٰهُ النَّجۡدَيۡنِ​ۚ‏"},{"ayah":11,"text":"فَلَا اقۡتَحَمَ الۡعَقَبَةَ ۖ‏"},{"ayah":12,"text":"وَمَاۤ اَدۡرٰٮكَ مَا الۡعَقَبَةُ ؕ‏"},{"ayah":13,"text":"فَكُّ رَقَبَةٍ ۙ‏"},{"ayah":14,"text":"اَوۡ اِطۡعٰمٌ فِىۡ يَوۡمٍ ذِىۡ مَسۡغَبَةٍ ۙ‏"},{"ayah":15,"text":"يَّتِيۡمًا ذَا مَقۡرَبَةٍ ۙ‏"},{"ayah":16,"text":"اَوۡ مِسۡكِيۡنًا ذَا مَتۡرَبَةٍ ؕ‏"},{"ayah":17,"text":"ثُمَّ كَانَ مِنَ الَّذِيۡنَ اٰمَنُوۡا وَتَوَاصَوۡا بِالصَّبۡرِ وَتَوَاصَوۡا بِالۡمَرۡحَمَةِ ؕ‏"},{"ayah":18,"text":"اُولٰٓٮِٕكَ اَصۡحٰبُ الۡمَيۡمَنَةِ ؕ‏"},{"ayah":19,"text":"وَالَّذِيۡنَ كَفَرُوۡا بِاٰيٰتِنَا هُمۡ اَصۡحٰبُ الۡمَشۡـَٔـمَةِ ؕ‏"},{"ayah":20,"text":"عَلَيۡهِمۡ نَارٌ مُّؤۡصَدَةٌ‏"}]}