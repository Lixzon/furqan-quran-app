{"surah":88,"ayahs":[{"ayah":1,"text":"هَلۡ اَتٰٮكَ حَدِيۡثُ الۡغَاشِيَةِؕ‏"},{"ayah":2,"text":"وُجُوۡهٌ يَّوۡمَٮِٕذٍ خَاشِعَةٌ ۙ‏"},{"ayah":3,"text":"عَامِلَةٌ نَّاصِبَةٌ ۙ‏"},{"ayah":4,"text":"تَصۡلٰى نَارًا حَامِيَةً ۙ‏"},{"ayah":5,"text":"تُسۡقٰى مِنۡ عَيۡنٍ اٰنِيَةٍؕ‏"},{"ayah":6,"text":"لَـيۡسَ لَهُمۡ طَعَامٌ اِلَّا مِنۡ ضَرِيۡعٍۙ‏"},{"ayah":7,"text":"لَّا يُسۡمِنُ وَلَا يُغۡنِىۡ مِنۡ جُوۡعٍؕ‏"},{"ayah":8,"text":"وُجُوۡهٌ يَّوۡمَٮِٕذٍ نَّاعِمَةٌ ۙ‏"},{"ayah":9,"text":"لِّسَعۡيِهَا رَاضِيَةٌ ۙ‏"},{"ayah":10,"text":"فِىۡ جَنَّةٍ عَالِيَةٍۙ‏"},{"ayah":11,"text":"لَّا تَسۡمَعُ فِيۡهَا لَاغِيَةً ؕ‏"},{"ayah":12,"text":"فِيۡهَا عَيۡنٌ جَارِيَةٌ​ ۘ‏"},{"ayah":13,"text":"فِيۡهَا سُرُرٌ مَّرۡفُوۡعَةٌ ۙ‏"},{"ayah":14,"text":"وَّاَكۡوَابٌ مَّوۡضُوۡعَةٌ ۙ‏"},{"ayah":15,"text":"وَّنَمَارِقُ مَصۡفُوۡفَةٌ ۙ‏"},{"ayah":16,"text":"وَّزَرَابِىُّ مَبۡثُوۡثَةٌ ؕ‏"},{"ayah":17,"text":"اَفَلَا يَنۡظُرُوۡنَ اِلَى الۡاِ بِلِ كَيۡفَ خُلِقَتۡ‏"},{"ayah":18,"text":"وَاِلَى السَّمَآءِ كَيۡفَ رُفِعَتۡ‏"},{"ayah":19,"text":"وَاِلَى الۡجِبَالِ كَيۡفَ نُصِبَتۡ‏"},{"ayah":20,"text":"وَاِلَى الۡاَرۡضِ كَيۡفَ سُطِحَتۡ‏"},{"ayah":21,"text":"فَذَكِّرۡ ؕ اِنَّمَاۤ اَنۡتَ مُذَكِّرٌ ؕ‏"},{"ayah":22,"text":"لَـسۡتَ عَلَيۡهِمۡ بِمُصَۜيۡطِرٍۙ‏"},{"ayah":23,"text":"اِلَّا مَنۡ تَوَلّٰى وَكَفَرَۙ‏"},{"ayah":24,"text":"فَيُعَذِّبُهُ اللّٰهُ الۡعَذَابَ الۡاَكۡبَرَؕ‏"},{"ayah":25,"text":"اِنَّ اِلَيۡنَاۤ اِيَابَهُمۡۙ‏"},{"ayah":26,"text":"ثُمَّ اِنَّ عَلَيۡنَا حِسَابَهُمْ‏"}]}