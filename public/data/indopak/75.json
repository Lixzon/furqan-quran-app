{"surah":75,"ayahs":[{"ayah":1,"text":"لَاۤ اُقۡسِمُ بِيَوۡمِ الۡقِيٰمَةِۙ‏"},{"ayah":2,"text":"وَلَاۤ اُقۡسِمُ بِالنَّفۡسِ اللَّوَّامَةِؕ‏"},{"ayah":3,"text":"اَيَحۡسَبُ الۡاِنۡسَانُ اَلَّنۡ نَّجۡمَعَ عِظَامَهٗؕ‏"},{"ayah":4,"text":"بَلٰى قٰدِرِيۡنَ عَلٰٓى اَنۡ نُّسَوِّىَ بَنَانَهٗ‏"},{"ayah":5,"text":"بَلۡ يُرِيۡدُ الۡاِنۡسَانُ لِيَفۡجُرَ اَمَامَهٗ​ۚ‏"},{"ayah":6,"text":"يَسۡـَٔـلُ اَيَّانَ يَوۡمُ الۡقِيٰمَةِؕ‏"},{"ayah":7,"text":"فَاِذَا بَرِقَ الۡبَصَرُۙ‏"},{"ayah":8,"text":"وَخَسَفَ الۡقَمَرُۙ‏"},{"ayah":9,"text":"وَجُمِعَ الشَّمۡسُ وَالۡقَمَرُۙ‏"},{"ayah":10,"text":"يَقُوۡلُ الۡاِنۡسَانُ يَوۡمَٮِٕذٍ اَيۡنَ الۡمَفَرُّ​ ۚ‏"},{"ayah":11,"text":"كَلَّا لَا وَزَرَؕ‏"},{"ayah":12,"text":"اِلٰى رَبِّكَ يَوۡمَٮِٕذِ اۨلۡمُسۡتَقَرُّ ؕ‏"},{"ayah":13,"text":"يُنَبَّؤُا الۡاِنۡسَانُ يَوۡمَٮِٕذٍۢ بِمَا قَدَّمَ وَاَخَّرَؕ‏"},{"ayah":14,"text":"بَلِ الۡاِنۡسَانُ عَلٰى نَفۡسِهٖ بَصِيۡرَةٌ ۙ‏"},{"ayah":15,"text":"وَّلَوۡ اَلۡقٰى مَعَاذِيۡرَهٗؕ‏"},{"ayah":16,"text":"لَا تُحَرِّكۡ بِهٖ لِسَانَكَ لِتَعۡجَلَ بِهٖؕ‏"},{"ayah":17,"text":"اِنَّ عَلَيۡنَا جَمۡعَهٗ وَقُرۡاٰنَهٗۚ  ۖ‏"},{"ayah":18,"text":"فَاِذَا قَرَاۡنٰهُ فَاتَّبِعۡ قُرۡاٰنَهٗ​ۚ‏"},{"ayah":19,"text":"ثُمَّ اِنَّ عَلَيۡنَا بَيَانَهٗؕ‏"},{"ayah":20,"text":"كَلَّا بَلۡ تُحِبُّوۡنَ الۡعَاجِلَةَ ۙ‏"},{"ayah":21,"text":"وَتَذَرُوۡنَ الۡاٰخِرَةَ ؕ‏"},{"ayah":22,"text":"وُجُوۡهٌ يَّوۡمَٮِٕذٍ نَّاضِرَةٌ ۙ‏"},{"ayah":23,"text":"اِلٰى رَبِّهَا نَاظِرَةٌ​ ۚ‏"},{"ayah":24,"text":"وَوُجُوۡهٌ يَّوۡمَٮِٕذٍۢ بَاسِرَةٌ ۙ‏"},{"ayah":25,"text":"تَظُنُّ اَنۡ يُّفۡعَلَ بِهَا فَاقِرَةٌ ؕ‏"},{"ayah":26,"text":"كَلَّاۤ اِذَا بَلَغَتِ التَّرَاقِىَۙ‏"},{"ayah":27,"text":"وَقِيۡلَ مَنۡ رَاقٍۙ‏"},{"ayah":28,"text":"وَّظَنَّ اَنَّهُ الۡفِرَاقُۙ‏"},{"ayah":29,"text":"وَالۡتَفَّتِ السَّاقُ بِالسَّاقِۙ‏"},{"ayah":30,"text":"اِلٰى رَبِّكَ يَوۡمَٮِٕذِ اۨلۡمَسَاقُؕ‏"},{"ayah":31,"text":"فَلَا صَدَّقَ وَلَا صَلّٰىۙ‏"},{"ayah":32,"text":"وَلٰڪِنۡ كَذَّبَ وَتَوَلّٰىۙ‏"},{"ayah":33,"text":"ثُمَّ ذَهَبَ اِلٰٓى اَهۡلِهٖ يَتَمَطّٰىؕ‏"},{"ayah":34,"text":"اَوۡلٰى لَكَ فَاَوۡلٰىۙ‏"},{"ayah":35,"text":"ثُمَّ اَوۡلٰى لَكَ فَاَوۡلٰىؕ‏"},{"ayah":36,"text":"اَيَحۡسَبُ الۡاِنۡسَانُ اَنۡ يُّتۡرَكَ سُدًىؕ‏"},{"ayah":37,"text":"اَلَمۡ يَكُ نُطۡفَةً مِّنۡ مَّنِىٍّ يُّمۡنٰىۙ‏"},{"ayah":38,"text":"ثُمَّ كَانَ عَلَقَةً فَخَلَقَ فَسَوّٰىۙ‏"},{"ayah":39,"text":"فَجَعَلَ مِنۡهُ الزَّوۡجَيۡنِ الذَّكَرَ وَالۡاُنۡثٰىؕ‏"},{"ayah":40,"text":"اَلَيۡسَ ذٰلِكَ بِقٰدِرٍ عَلٰٓى اَنۡ يُّحۡـىِۦَ الۡمَوۡتٰى‏"}]}