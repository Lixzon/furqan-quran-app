{"surah":87,"ayahs":[{"ayah":1,"text":"سَبِّحِ اسۡمَ رَبِّكَ الۡاَعۡلَىۙ‏"},{"ayah":2,"text":"الَّذِىۡ خَلَقَ فَسَوّٰى ۙ‏"},{"ayah":3,"text":"وَالَّذِىۡ قَدَّرَ فَهَدٰى ۙ‏"},{"ayah":4,"text":"وَالَّذِىۡۤ اَخۡرَجَ الۡمَرۡعٰى ۙ‏"},{"ayah":5,"text":"فَجَعَلَهٗ غُثَآءً اَحۡوٰىؕ‏"},{"ayah":6,"text":"سَنُقۡرِئُكَ فَلَا تَنۡسٰٓىۙ‏"},{"ayah":7,"text":"اِلَّا مَا شَآءَ اللّٰهُ​ؕ اِنَّهٗ يَعۡلَمُ الۡجَهۡرَ وَمَا يَخۡفٰىؕ‏"},{"ayah":8,"text":"وَنُيَسِّرُكَ لِلۡيُسۡرٰى ​ۖ​ۚ‏"},{"ayah":9,"text":"فَذَكِّرۡ اِنۡ نَّفَعَتِ الذِّكۡرٰىؕ‏"},{"ayah":10,"text":"سَيَذَّكَّرُ مَنۡ يَّخۡشٰىۙ‏"},{"ayah":11,"text":"وَيَتَجَنَّبُهَا الۡاَشۡقَىۙ‏"},{"ayah":12,"text":"الَّذِىۡ يَصۡلَى النَّارَ الۡكُبۡرٰى​ۚ‏"},{"ayah":13,"text":"ثُمَّ لَا يَمُوۡتُ فِيۡهَا وَلَا يَحۡيٰىؕ‏"},{"ayah":14,"text":"قَدۡ اَفۡلَحَ مَنۡ تَزَكّٰىۙ‏"},{"ayah":15,"text":"وَذَكَرَ اسۡمَ رَبِّهٖ فَصَلّٰى​ ؕ‏"},{"ayah":16,"text":"بَلۡ تُؤۡثِرُوۡنَ الۡحَيٰوةَ الدُّنۡيَا ۖ‏"},{"ayah":17,"text":"وَالۡاٰخِرَةُ خَيۡرٌ وَّ اَبۡقٰىؕ‏"},{"ayah":18,"text":"اِنَّ هٰذَا لَفِى الصُّحُفِ الۡاُوۡلٰىۙ‏"},{"ayah":19,"text":"صُحُفِ اِبۡرٰهِيۡمَ وَمُوۡسٰى‏"}]}