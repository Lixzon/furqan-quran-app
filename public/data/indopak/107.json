{"surah":107,"ayahs":[{"ayah":1,"text":"اَرَءَيۡتَ الَّذِىۡ يُكَذِّبُ بِالدِّيۡنِؕ‏"},{"ayah":2,"text":"فَذٰلِكَ الَّذِىۡ يَدُعُّ الۡيَتِيۡمَۙ‏"},{"ayah":3,"text":"وَ لَا يَحُضُّ عَلٰى طَعَامِ الۡمِسۡكِيۡنِؕ‏"},{"ayah":4,"text":"فَوَيۡلٌ لِّلۡمُصَلِّيۡنَۙ‏"},{"ayah":5,"text":"الَّذِيۡنَ هُمۡ عَنۡ صَلَاتِهِمۡ سَاهُوۡنَۙ‏"},{"ayah":6,"text":"الَّذِيۡنَ هُمۡ يُرَآءُوۡنَۙ‏"},{"ayah":7,"text":"وَيَمۡنَعُوۡنَ الۡمَاعُوۡنَ‏"}]}