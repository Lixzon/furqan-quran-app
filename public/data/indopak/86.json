{"surah":86,"ayahs":[{"ayah":1,"text":"وَالسَّمَآءِ وَالطَّارِقِۙ‏"},{"ayah":2,"text":"وَمَاۤ اَدۡرٰٮكَ مَا الطَّارِقُۙ‏"},{"ayah":3,"text":"النَّجۡمُ الثَّاقِبُۙ‏"},{"ayah":4,"text":"اِنۡ كُلُّ نَفۡسٍ لَّمَّا عَلَيۡهَا حَافِظٌؕ‏"},{"ayah":5,"text":"فَلۡيَنۡظُرِ الۡاِنۡسَانُ مِمَّ خُلِقَؕ‏"},{"ayah":6,"text":"خُلِقَ مِنۡ مَّآءٍ دَافِقٍۙ‏"},{"ayah":7,"text":"يَّخۡرُجُ مِنۡۢ بَيۡنِ الصُّلۡبِ وَالتَّرَآٮِٕبِؕ‏"},{"ayah":8,"text":"اِنَّهٗ عَلٰى رَجۡعِهٖ لَقَادِرٌؕ‏"},{"ayah":9,"text":"يَوۡمَ تُبۡلَى السَّرَآٮِٕرُۙ‏"},{"ayah":10,"text":"فَمَا لَهٗ مِنۡ قُوَّةٍ وَّلَا نَاصِرٍؕ‏"},{"ayah":11,"text":"وَالسَّمَآءِ ذَاتِ الرَّجۡعِۙ‏"},{"ayah":12,"text":"وَالۡاَرۡضِ ذَاتِ الصَّدۡعِۙ‏"},{"ayah":13,"text":"اِنَّهٗ لَقَوۡلٌ فَصۡلٌۙ‏"},{"ayah":14,"text":"وَّمَا هُوَ بِالۡهَزۡلِؕ‏"},{"ayah":15,"text":"اِنَّهُمۡ يَكِيۡدُوۡنَ كَيۡدًا ۙ‏"},{"ayah":16,"text":"وَّاَكِيۡدُ كَيۡدًا ۚۖ‏"},{"ayah":17,"text":"فَمَهِّلِ الۡكٰفِرِيۡنَ اَمۡهِلۡهُمۡ رُوَيۡدًا‏"}]}