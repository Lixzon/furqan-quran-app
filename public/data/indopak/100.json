{"surah":100,"ayahs":[{"ayah":1,"text":"وَالۡعٰدِيٰتِ ضَبۡحًا ۙ‏"},{"ayah":2,"text":"فَالۡمُوۡرِيٰتِ قَدۡحًا ۙ‏"},{"ayah":3,"text":"فَالۡمُغِيۡرٰتِ صُبۡحًا ۙ‏"},{"ayah":4,"text":"فَاَثَرۡنَ بِهٖ نَقۡعًا ۙ‏"},{"ayah":5,"text":"فَوَسَطۡنَ بِهٖ جَمۡعًا ۙ‏"},{"ayah":6,"text":"اِنَّ الۡاِنۡسَانَ لِرَبِّهٖ لَـكَنُوۡدٌ ۚ‏"},{"ayah":7,"text":"وَاِنَّهٗ عَلٰى ذٰلِكَ لَشَهِيۡدٌ ۚ‏"},{"ayah":8,"text":"وَاِنَّهٗ لِحُبِّ الۡخَيۡرِ لَشَدِيۡدٌ ؕ‏"},{"ayah":9,"text":"اَفَلَا يَعۡلَمُ اِذَا بُعۡثِرَ مَا فِى الۡقُبُوۡرِۙ‏"},{"ayah":10,"text":"وَحُصِّلَ مَا فِى الصُّدُوۡرِۙ‏"},{"ayah":11,"text":"اِنَّ رَبَّهُمۡ بِهِمۡ يَوۡمَٮِٕذٍ لَّخَبِيۡرٌ‏"}]}