{"surah":81,"ayahs":[{"ayah":1,"text":"اِذَا الشَّمۡسُ كُوِّرَتۡۙ‏"},{"ayah":2,"text":"وَاِذَا النُّجُوۡمُ انْكَدَرَتۡۙ‏"},{"ayah":3,"text":"وَاِذَا الۡجِبَالُ سُيِّرَتۡۙ‏"},{"ayah":4,"text":"وَاِذَا الۡعِشَارُ عُطِّلَتۡۙ‏"},{"ayah":5,"text":"وَاِذَا الۡوُحُوۡشُ حُشِرَتۡۙ‏"},{"ayah":6,"text":"وَاِذَا الۡبِحَارُ سُجِّرَتۡۙ‏"},{"ayah":7,"text":"وَاِذَا النُّفُوۡسُ زُوِّجَتۡۙ‏"},{"ayah":8,"text":"وَاِذَا الۡمَوۡءٗدَةُ سُٮِٕلَتۡۙ‏"},{"ayah":9,"text":"بِاَىِّ ذَنۡۢبٍ قُتِلَتۡ​ۚ‏"},{"ayah":10,"text":"وَاِذَا الصُّحُفُ نُشِرَتۡۙ‏"},{"ayah":11,"text":"وَاِذَا السَّمَآءُ كُشِطَتۡۙ‏"},{"ayah":12,"text":"وَاِذَا الۡجَحِيۡمُ سُعِّرَتۡۙ‏"},{"ayah":13,"text":"وَاِذَا الۡجَـنَّةُ اُزۡلِفَتۡۙ‏"},{"ayah":14,"text":"عَلِمَتۡ نَفۡسٌ مَّاۤ اَحۡضَرَتۡؕ‏"},{"ayah":15,"text":"فَلَاۤ اُقۡسِمُ بِالۡخُنَّسِۙ‏"},{"ayah":16,"text":"الۡجَوَارِ الۡكُنَّسِۙ‏"},{"ayah":17,"text":"وَالَّيۡلِ اِذَا عَسۡعَسَۙ‏"},{"ayah":18,"text":"وَالصُّبۡحِ اِذَا تَنَفَّسَۙ‏"},{"ayah":19,"text":"اِنَّهٗ لَقَوۡلُ رَسُوۡلٍ كَرِيۡمٍۙ‏"},{"ayah":20,"text":"ذِىۡ قُوَّةٍ عِنۡدَ ذِى الۡعَرۡشِ مَكِيۡنٍۙ‏"},{"ayah":21,"text":"مُّطَاعٍ ثَمَّ اَمِيۡنٍؕ‏"},{"ayah":22,"text":"وَ مَا صَاحِبُكُمۡ بِمَجۡنُوۡنٍ​ۚ‏"},{"ayah":23,"text":"وَلَقَدۡ رَاٰهُ بِالۡاُفُقِ الۡمُبِيۡنِ​ۚ‏"},{"ayah":24,"text":"وَمَا هُوَ عَلَى الۡغَيۡبِ بِضَنِيۡنٍ​ۚ‏"},{"ayah":25,"text":"وَمَا هُوَ بِقَوۡلِ شَيۡطٰنٍ رَّجِيۡمٍۙ‏"},{"ayah":26,"text":"فَاَيۡنَ تَذۡهَبُوۡنَؕ‏"},{"ayah":27,"text":"اِنۡ هُوَ اِلَّا ذِكۡرٌ لِّلۡعٰلَمِيۡنَۙ‏"},{"ayah":28,"text":"لِمَنۡ شَآءَ مِنۡكُمۡ اَنۡ يَّسۡتَقِيۡمَؕ‏"},{"ayah":29,"text":"وَمَا تَشَآءُوۡنَ اِلَّاۤ اَنۡ يَّشَآءَ اللّٰهُ رَبُّ الۡعٰلَمِيۡنَ‏"}]}