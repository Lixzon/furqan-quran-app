{"surah":93,"ayahs":[{"ayah":1,"text":"وَالضُّحٰىۙ‏"},{"ayah":2,"text":"وَالَّيۡلِ اِذَا سَجٰىۙ‏"},{"ayah":3,"text":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلٰىؕ‏"},{"ayah":4,"text":"وَلَـلۡاٰخِرَةُ خَيۡرٌ لَّكَ مِنَ الۡاُوۡلٰىؕ‏"},{"ayah":5,"text":"وَلَسَوۡفَ يُعۡطِيۡكَ رَبُّكَ فَتَرۡضٰىؕ‏"},{"ayah":6,"text":"اَلَمۡ يَجِدۡكَ يَتِيۡمًا فَاٰوٰى‏"},{"ayah":7,"text":"وَوَجَدَكَ ضَآ لًّا فَهَدٰى‏"},{"ayah":8,"text":"وَوَجَدَكَ عَآٮِٕلًا فَاَغۡنٰىؕ‏"},{"ayah":9,"text":"فَاَمَّا الۡيَتِيۡمَ فَلَا تَقۡهَرۡؕ‏"},{"ayah":10,"text":"وَاَمَّا السَّآٮِٕلَ فَلَا تَنۡهَرۡؕ‏"},{"ayah":11,"text":"وَاَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ‏"}]}