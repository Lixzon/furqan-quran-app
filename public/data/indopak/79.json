{"surah":79,"ayahs":[{"ayah":1,"text":"وَالنّٰزِعٰتِ غَرۡقًا ۙ‏"},{"ayah":2,"text":"وَّالنّٰشِطٰتِ نَشۡطًا ۙ‏"},{"ayah":3,"text":"وَّالسّٰبِحٰتِ سَبۡحًا ۙ‏"},{"ayah":4,"text":"فَالسّٰبِقٰتِ سَبۡقًا ۙ‏"},{"ayah":5,"text":"فَالۡمُدَبِّرٰتِ اَمۡرًا​ ۘ‏"},{"ayah":6,"text":"يَوۡمَ تَرۡجُفُ الرَّاجِفَةُ ۙ‏"},{"ayah":7,"text":"تَتۡبَعُهَا الرَّادِفَةُ ؕ‏"},{"ayah":8,"text":"قُلُوۡبٌ يَّوۡمَٮِٕذٍ وَّاجِفَةٌ ۙ‏"},{"ayah":9,"text":"اَبۡصَارُهَا خَاشِعَةٌ​ ۘ‏"},{"ayah":10,"text":"يَقُوۡلُوۡنَ ءَاِنَّا لَمَرۡدُوۡدُوۡنَ فِى الۡحَـافِرَةِ ؕ‏"},{"ayah":11,"text":"ءَاِذَا كُنَّا عِظَامًا نَّخِرَةً ؕ‏"},{"ayah":12,"text":"قَالُوۡا تِلۡكَ اِذًا كَرَّةٌ خَاسِرَةٌ​ ۘ‏"},{"ayah":13,"text":"فَاِنَّمَا هِىَ زَجۡرَةٌ وَّاحِدَةٌ ۙ‏"},{"ayah":14,"text":"فَاِذَا هُمۡ بِالسَّاهِرَةِ ؕ‏"},{"ayah":15,"text":"هَلۡ اَتٰٮكَ حَدِيۡثُ مُوۡسٰى​ۘ‏"},{"ayah":16,"text":"اِذۡ نَادٰٮهُ رَبُّهٗ بِالۡوَادِ الۡمُقَدَّسِ طُوًى​ۚ‏"},{"ayah":17,"text":"اِذۡهَبۡ اِلٰى فِرۡعَوۡنَ اِنَّهٗ طَغٰى ۖ‏"},{"ayah":18,"text":"فَقُلۡ هَلۡ لَّكَ اِلٰٓى اَنۡ تَزَكّٰى ۙ‏"},{"ayah":19,"text":"وَاَهۡدِيَكَ اِلٰى رَبِّكَ فَتَخۡشٰى​ۚ‏"},{"ayah":20,"text":"فَاَرٰٮهُ الۡاٰيَةَ الۡكُبۡرٰى ۖ‏"},{"ayah":21,"text":"فَكَذَّبَ وَعَصٰى ۖ‏"},{"ayah":22,"text":"ثُمَّ اَدۡبَرَ يَسۡعٰىۖ‏"},{"ayah":23,"text":"فَحَشَرَ فَنَادٰىۖ‏"},{"ayah":24,"text":"فَقَالَ اَنَا رَبُّكُمُ الۡاَعۡلٰى ۖ‏"},{"ayah":25,"text":"فَاَخَذَهُ اللّٰهُ نَڪَالَ الۡاٰخِرَةِ وَالۡاُوۡلٰى ؕ‏"},{"ayah":26,"text":"اِنَّ فِىۡ ذٰلِكَ لَعِبۡرَةً لِّمَنۡ يَّخۡشٰىؕ‏"},{"ayah":27,"text":"ءَاَنۡتُمۡ اَشَدُّ خَلۡقًا اَمِ السَّمَآءُ​ ؕ بَنٰٮهَا‏"},{"ayah":28,"text":"رَفَعَ سَمۡكَهَا فَسَوَّٮهَا ۙ‏"},{"ayah":29,"text":"وَ اَغۡطَشَ لَيۡلَهَا وَاَخۡرَجَ ضُحٰٮهَا‏"},{"ayah":30,"text":"وَالۡاَرۡضَ بَعۡدَ ذٰلِكَ دَحٰٮهَا ؕ‏"},{"ayah":31,"text":"اَخۡرَجَ مِنۡهَا مَآءَهَا وَمَرۡعٰٮهَا‏"},{"ayah":32,"text":"وَالۡجِبَالَ اَرۡسٰٮهَا ۙ‏"},{"ayah":33,"text":"مَتَاعًا لَّـكُمۡ وَلِاَنۡعَامِكُمۡؕ‏"},{"ayah":34,"text":"فَاِذَا جَآءَتِ الطَّآمَّةُ الۡكُبۡرٰى ۖ‏"},{"ayah":35,"text":"يَوۡمَ يَتَذَكَّرُ الۡاِنۡسَانُ مَا سَعٰىۙ‏"},{"ayah":36,"text":"وَبُرِّزَتِ الۡجَحِيۡمُ لِمَنۡ يَّرٰى‏"},{"ayah":37,"text":"فَاَمَّا مَنۡ طَغٰىۙ‏"},{"ayah":38,"text":"وَاٰثَرَ الۡحَيٰوةَ الدُّنۡيَا ۙ‏"},{"ayah":39,"text":"فَاِنَّ الۡجَحِيۡمَ هِىَ الۡمَاۡوٰىؕ‏"},{"ayah":40,"text":"وَاَمَّا مَنۡ خَافَ مَقَامَ رَبِّهٖ وَ نَهَى النَّفۡسَ عَنِ الۡهَوٰىۙ‏"},{"ayah":41,"text":"فَاِنَّ الۡجَـنَّةَ هِىَ الۡمَاۡوٰىؕ‏"},{"ayah":42,"text":"يَسۡـــَٔلُوۡنَكَ عَنِ السَّاعَةِ اَيَّانَ مُرۡسٰٮهَا ؕ‏"},{"ayah":43,"text":"فِيۡمَ اَنۡتَ مِنۡ ذِكۡرٰٮهَاؕ‏"},{"ayah":44,"text":"اِلٰى رَبِّكَ مُنۡتَهٰٮهَاؕ‏"},{"ayah":45,"text":"اِنَّمَاۤ اَنۡتَ مُنۡذِرُ مَنۡ يَّخۡشٰٮهَاؕ‏"},{"ayah":46,"text":"كَاَنَّهُمۡ يَوۡمَ يَرَوۡنَهَا لَمۡ يَلۡبَثُوۡۤا اِلَّا عَشِيَّةً اَوۡ ضُحٰٮهَا‏"}]}