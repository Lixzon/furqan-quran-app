{"surah":56,"ayahs":[{"ayah":1,"text":"اِذَا وَقَعَتِ الۡوَاقِعَةُ ۙ‏"},{"ayah":2,"text":"لَيۡسَ لِـوَقۡعَتِهَا كَاذِبَةٌ​ ۘ‏"},{"ayah":3,"text":"خَافِضَةٌ رَّافِعَةٌ ۙ‏"},{"ayah":4,"text":"اِذَا رُجَّتِ الۡاَرۡضُ رَجًّا ۙ‏"},{"ayah":5,"text":"وَّبُسَّتِ الۡجِبَالُ بَسًّا ۙ‏"},{"ayah":6,"text":"فَكَانَتۡ هَبَآءً مُّنۡۢبَـثًّا ۙ‏"},{"ayah":7,"text":"وَّكُنۡـتُمۡ اَزۡوَاجًا ثَلٰـثَـةً ؕ‏"},{"ayah":8,"text":"فَاَصۡحٰبُ الۡمَيۡمَنَةِ ۙ مَاۤ اَصۡحٰبُ الۡمَيۡمَنَةِ ؕ‏"},{"ayah":9,"text":"وَاَصۡحٰبُ الۡمَشۡـَٔـمَةِ ۙ مَاۤ اَصۡحٰبُ الۡمَشۡـَٔـمَةِؕ‏"},{"ayah":10,"text":"وَالسّٰبِقُوۡنَ السّٰبِقُوۡنَۚ  ۙ‏"},{"ayah":11,"text":"اُولٰٓٮِٕكَ الۡمُقَرَّبُوۡنَ​ۚ‏"},{"ayah":12,"text":"فِىۡ جَنّٰتِ النَّعِيۡمِ‏"},{"ayah":13,"text":"ثُلَّةٌ مِّنَ الۡاَوَّلِيۡنَۙ‏"},{"ayah":14,"text":"وَقَلِيۡلٌ مِّنَ الۡاٰخِرِيۡنَؕ‏"},{"ayah":15,"text":"عَلٰى سُرُرٍ مَّوۡضُوۡنَةٍۙ‏"},{"ayah":16,"text":"مُّتَّكِـــِٕيۡنَ عَلَيۡهَا مُتَقٰبِلِيۡنَ‏"},{"ayah":17,"text":"يَطُوۡفُ عَلَيۡهِمۡ وِلۡدَانٌ مُّخَلَّدُوۡنَۙ‏"},{"ayah":18,"text":"بِاَكۡوَابٍ وَّاَبَارِيۡقَ ۙ وَكَاۡسٍ مِّنۡ مَّعِيۡنٍۙ‏"},{"ayah":19,"text":"لَّا يُصَدَّعُوۡنَ عَنۡهَا وَلَا يُنۡزِفُوۡنَۙ‏"},{"ayah":20,"text":"وَفَاكِهَةٍ مِّمَّا يَتَخَيَّرُوۡنَۙ‏"},{"ayah":21,"text":"وَلَحۡمِ طَيۡرٍ مِّمَّا يَشۡتَهُوۡنَؕ‏"},{"ayah":22,"text":"وَحُوۡرٌ عِيۡنٌۙ‏"},{"ayah":23,"text":"كَاَمۡثَالِ اللُّـؤۡلُـوٴِالۡمَكۡنُوۡنِ​ۚ‏"},{"ayah":24,"text":"جَزَآءًۢ بِمَا كَانُوۡا يَعۡمَلُوۡنَ‏"},{"ayah":25,"text":"لَا يَسۡمَعُوۡنَ فِيۡهَا لَغۡوًا وَّلَا تَاۡثِيۡمًا ۙ‏"},{"ayah":26,"text":"اِلَّا قِيۡلًا سَلٰمًا سَلٰمًا‏"},{"ayah":27,"text":"وَاَصۡحٰبُ الۡيَمِيۡنِ ۙ مَاۤ اَصۡحٰبُ الۡيَمِيۡنِؕ‏"},{"ayah":28,"text":"فِىۡ سِدۡرٍ مَّخۡضُوۡدٍۙ‏"},{"ayah":29,"text":"وَّطَلۡحٍ مَّنۡضُوۡدٍۙ‏"},{"ayah":30,"text":"وَّظِلٍّ مَّمۡدُوۡدٍۙ‏"},{"ayah":31,"text":"وَّ مَآءٍ مَّسۡكُوۡبٍۙ‏"},{"ayah":32,"text":"وَّفَاكِهَةٍ كَثِيۡرَةٍۙ‏"},{"ayah":33,"text":"لَّا مَقۡطُوۡعَةٍ وَّلَا مَمۡنُوۡعَةٍۙ‏"},{"ayah":34,"text":"وَّ فُرُشٍ مَّرۡفُوۡعَةٍؕ‏"},{"ayah":35,"text":"اِنَّاۤ اَنۡشَاۡنٰهُنَّ اِنۡشَآءًۙ‏"},{"ayah":36,"text":"فَجَعَلۡنٰهُنَّ اَبۡكَارًاۙ‏"},{"ayah":37,"text":"عُرُبًا اَتۡرَابًاۙ‏"},{"ayah":38,"text":"لِّاَصۡحٰبِ الۡيَمِيۡنِؕ‏"},{"ayah":39,"text":"ثُلَّةٌ مِّنَ الۡاَوَّلِيۡنَۙ‏"},{"ayah":40,"text":"وَثُلَّةٌ مِّنَ الۡاٰخِرِيۡنَؕ‏"},{"ayah":41,"text":"وَاَصۡحٰبُ الشِّمَالِ ۙ مَاۤ اَصۡحٰبُ الشِّمَالِؕ‏"},{"ayah":42,"text":"فِىۡ سَمُوۡمٍ وَّحَمِيۡمٍۙ‏"},{"ayah":43,"text":"وَّظِلٍّ مِّنۡ يَّحۡمُوۡمٍۙ‏"},{"ayah":44,"text":"لَّا بَارِدٍ وَّلَا كَرِيۡمٍ‏"},{"ayah":45,"text":"اِنَّهُمۡ كَانُوۡا قَبۡلَ ذٰ لِكَ مُتۡرَفِيۡنَۚ  ۖ‏"},{"ayah":46,"text":"وَكَانُوۡا يُصِرُّوۡنَ عَلَى الۡحِنۡثِ الۡعَظِيۡمِ​ۚ‏"},{"ayah":47,"text":"وَكَانُوۡا يَقُوۡلُوۡنَ ۙ اَٮِٕذَا مِتۡنَا وَكُنَّا تُرَابًا وَّعِظَامًا ءَاِنَّا لَمَبۡعُوۡثُوۡنَۙ‏"},{"ayah":48,"text":"اَوَاٰبَآؤُنَا الۡاَوَّلُوۡنَ‏"},{"ayah":49,"text":"قُلۡ اِنَّ الۡاَوَّلِيۡنَ وَالۡاٰخِرِيۡنَۙ‏"},{"ayah":50,"text":"لَمَجۡمُوۡعُوۡنَ ۙ اِلٰى مِيۡقَاتِ يَوۡمٍ مَّعۡلُوۡمٍ‏"},{"ayah":51,"text":"ثُمَّ اِنَّكُمۡ اَيُّهَا الضَّآلُّوۡنَ الۡمُكَذِّبُوۡنَۙ‏"},{"ayah":52,"text":"لَاٰكِلُوۡنَ مِنۡ شَجَرٍ مِّنۡ زَقُّوۡمٍۙ‏"},{"ayah":53,"text":"فَمٰلِــُٔوۡنَ مِنۡهَا الۡبُطُوۡنَ​ۚ‏"},{"ayah":54,"text":"فَشٰرِبُوۡنَ عَلَيۡهِ مِنَ الۡحَمِيۡمِ​ۚ‏"},{"ayah":55,"text":"فَشٰرِبُوۡنَ شُرۡبَ الۡهِيۡمِؕ‏"},{"ayah":56,"text":"هٰذَا نُزُلُهُمۡ يَوۡمَ الدِّيۡنِؕ‏"},{"ayah":57,"text":"نَحۡنُ خَلَقۡنٰكُمۡ فَلَوۡلَا تُصَدِّقُوۡنَ‏"},{"ayah":58,"text":"اَفَرَءَيۡتُمۡ مَّا تُمۡنُوۡنَؕ‏"},{"ayah":59,"text":"ءَاَنۡتُمۡ تَخۡلُقُوۡنَهٗۤ اَمۡ نَحۡنُ الۡخٰلِقُوۡنَ‏"},{"ayah":60,"text":"نَحۡنُ قَدَّرۡنَا بَيۡنَكُمُ الۡمَوۡتَ وَمَا نَحۡنُ بِمَسۡبُوۡقِيۡنَۙ‏"},{"ayah":61,"text":"عَلٰٓى اَنۡ نُّبَدِّلَ اَمۡثَالَـكُمۡ وَنُـنۡشِئَكُمۡ فِىۡ مَا لَا تَعۡلَمُوۡنَ‏"},{"ayah":62,"text":"وَلَـقَدۡ عَلِمۡتُمُ النَّشۡاَةَ الۡاُوۡلٰى فَلَوۡلَا تَذَكَّرُوۡنَ‏"},{"ayah":63,"text":"اَفَرَءَيۡتُمۡ مَّا تَحۡرُثُوۡنَؕ‏"},{"ayah":64,"text":"ءَاَنۡتُمۡ تَزۡرَعُوۡنَهٗۤ اَمۡ نَحۡنُ الزّٰرِعُوۡنَ‏"},{"ayah":65,"text":"لَوۡ نَشَآءُ لَجَـعَلۡنٰهُ حُطَامًا فَظَلۡتُمۡ تَفَكَّهُوۡنَ‏"},{"ayah":66,"text":"اِنَّا لَمُغۡرَمُوۡنَۙ‏"},{"ayah":67,"text":"بَلۡ نَحۡنُ مَحۡرُوۡمُوۡنَ‏"},{"ayah":68,"text":"اَفَرَءَيۡتُمُ الۡمَآءَ الَّذِىۡ تَشۡرَبُوۡنَؕ‏"},{"ayah":69,"text":"ءَاَنۡـتُمۡ اَنۡزَلۡـتُمُوۡهُ مِنَ الۡمُزۡنِ اَمۡ نَحۡنُ الۡمُنۡزِلُوۡنَ‏"},{"ayah":70,"text":"لَوۡ نَشَآءُ جَعَلۡنٰهُ اُجَاجًا فَلَوۡلَا تَشۡكُرُوۡنَ‏"},{"ayah":71,"text":"اَفَرَءَيۡتُمُ النَّارَ الَّتِىۡ تُوۡرُوۡنَؕ‏"},{"ayah":72,"text":"ءَاَنۡتُمۡ اَنۡشَاۡتُمۡ شَجَرَتَهَاۤ اَمۡ نَحۡنُ الۡمُنۡشِـُٔـوۡنَ‏"},{"ayah":73,"text":"نَحۡنُ جَعَلۡنٰهَا تَذۡكِرَةً وَّمَتَاعًا لِّلۡمُقۡوِيۡنَ​ۚ‏"},{"ayah":74,"text":"فَسَبِّحۡ بِاسۡمِ رَبِّكَ الۡعَظِيۡمِ‏"},{"ayah":75,"text":"فَلَاۤ اُقۡسِمُ بِمَوٰقِعِ النُّجُوۡمِۙ‏‏"},{"ayah":76,"text":"وَاِنَّهٗ لَقَسَمٌ لَّوۡ تَعۡلَمُوۡنَ عَظِيۡمٌۙ‏"},{"ayah":77,"text":"اِنَّهٗ لَـقُرۡاٰنٌ كَرِيۡمٌۙ‏"},{"ayah":78,"text":"فِىۡ كِتٰبٍ مَّكۡنُوۡنٍۙ‏"},{"ayah":79,"text":"لَّا يَمَسُّهٗۤ اِلَّا الۡمُطَهَّرُوۡنَؕ‏"},{"ayah":80,"text":"تَنۡزِيۡلٌ مِّنۡ رَّبِّ الۡعٰلَمِيۡنَ‏"},{"ayah":81,"text":"اَفَبِهٰذَا الۡحَـدِيۡثِ اَنۡتُمۡ مُّدۡهِنُوۡنَۙ‏"},{"ayah":82,"text":"وَتَجۡعَلُوۡنَ رِزۡقَكُمۡ اَنَّكُمۡ تُكَذِّبُوۡنَ‏"},{"ayah":83,"text":"فَلَوۡلَاۤ اِذَا بَلَغَتِ الۡحُـلۡقُوۡمَۙ‏"},{"ayah":84,"text":"وَاَنۡتُمۡ حِيۡنَٮِٕذٍ تَـنۡظُرُوۡنَۙ‏"},{"ayah":85,"text":"وَنَحۡنُ اَقۡرَبُ اِلَيۡهِ مِنۡكُمۡ وَلٰـكِنۡ لَّا تُبۡصِرُوۡنَ‏"},{"ayah":86,"text":"فَلَوۡلَاۤ اِنۡ كُنۡتُمۡ غَيۡرَ مَدِيۡنِيۡنَۙ‏"},{"ayah":87,"text":"تَرۡجِعُوۡنَهَاۤ اِنۡ كُنۡتُمۡ صٰدِقِيۡنَ‏"},{"ayah":88,"text":"فَاَمَّاۤ اِنۡ كَانَ مِنَ الۡمُقَرَّبِيۡنَۙ‏"},{"ayah":89,"text":"فَرَوۡحٌ وَّ رَيۡحَانٌ ۙ وَّجَنَّتُ نَعِيۡمٍ‏"},{"ayah":90,"text":"وَاَمَّاۤ اِنۡ كَانَ مِنۡ اَصۡحٰبِ الۡيَمِيۡنِۙ‏"},{"ayah":91,"text":"فَسَلٰمٌ لَّكَ مِنۡ اَصۡحٰبِ الۡيَمِيۡنِؕ‏"},{"ayah":92,"text":"وَاَمَّاۤ اِنۡ كَانَ مِنَ الۡمُكَذِّبِيۡنَ الضَّآلِّيۡنَۙ‏"},{"ayah":93,"text":"فَنُزُلٌ مِّنۡ حَمِيۡمٍۙ‏"},{"ayah":94,"text":"وَّتَصۡلِيَةُ جَحِيۡمٍ‏"},{"ayah":95,"text":"اِنَّ هٰذَا لَهُوَ حَقُّ الۡيَـقِيۡنِۚ‏"},{"ayah":96,"text":"فَسَبِّحۡ بِاسۡمِ رَبِّكَ الۡعَظِيۡمِ‏"}]}