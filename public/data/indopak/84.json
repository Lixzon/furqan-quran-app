{"surah":84,"ayahs":[{"ayah":1,"text":"اِذَا السَّمَآءُ انْشَقَّتۡۙ‏"},{"ayah":2,"text":"وَاَذِنَتۡ لِرَبِّهَا وَحُقَّتۡۙ‏"},{"ayah":3,"text":"وَاِذَا الۡاَرۡضُ مُدَّتۡؕ‏"},{"ayah":4,"text":"وَاَلۡقَتۡ مَا فِيۡهَا وَتَخَلَّتۡۙ‏"},{"ayah":5,"text":"وَاَذِنَتۡ لِرَبِّهَا وَحُقَّتۡؕ‏"},{"ayah":6,"text":"يٰۤاَيُّهَا الۡاِنۡسَانُ اِنَّكَ كَادِحٌ اِلٰى رَبِّكَ كَدۡحًا فَمُلٰقِيۡهِ​ۚ‏"},{"ayah":7,"text":"فَاَمَّا مَنۡ اُوۡتِىَ كِتٰبَهٗ بِيَمِيۡنِهٖۙ‏"},{"ayah":8,"text":"فَسَوۡفَ يُحَاسَبُ حِسَابًا يَّسِيۡرًا ۙ‏"},{"ayah":9,"text":"وَّيَنۡقَلِبُ اِلٰٓى اَهۡلِهٖ مَسۡرُوۡرًا ؕ‏"},{"ayah":10,"text":"وَاَمَّا مَنۡ اُوۡتِىَ كِتٰبَهٗ وَرَآءَ ظَهۡرِهٖۙ‏"},{"ayah":11,"text":"فَسَوۡفَ يَدۡعُوۡا ثُبُوۡرًا ۙ‏"},{"ayah":12,"text":"وَّيَصۡلٰى سَعِيۡرًا ؕ‏"},{"ayah":13,"text":"اِنَّهٗ كَانَ فِىۡۤ اَهۡلِهٖ مَسۡرُوۡرًا ؕ‏"},{"ayah":14,"text":"اِنَّهٗ ظَنَّ اَنۡ لَّنۡ يَّحُوۡرَ ۛۚ‏"},{"ayah":15,"text":"بَلٰٓى ۛۚ اِنَّ رَبَّهٗ كَانَ بِهٖ بَصِيۡرًا ؕ‏"},{"ayah":16,"text":"فَلَاۤ اُقۡسِمُ بِالشَّفَقِۙ‏"},{"ayah":17,"text":"وَالَّيۡلِ وَمَا وَسَقَۙ‏"},{"ayah":18,"text":"وَالۡقَمَرِ اِذَا اتَّسَقَۙ‏"},{"ayah":19,"text":"لَتَرۡكَبُنَّ طَبَقًا عَنۡ طَبَقٍؕ‏"},{"ayah":20,"text":"فَمَا لَهُمۡ لَا يُؤۡمِنُوۡنَۙ‏"},{"ayah":21,"text":"وَاِذَا قُرِئَ عَلَيۡهِمُ الۡقُرۡاٰنُ لَا يَسۡجُدُوۡنَ ؕ ۩‏"},{"ayah":22,"text":"بَلِ الَّذِيۡنَ كَفَرُوۡا يُكَذِّبُوۡنَ ۖ‏"},{"ayah":23,"text":"وَاللّٰهُ اَعۡلَمُ بِمَا يُوۡعُوۡنَ ۖ‏"},{"ayah":24,"text":"فَبَشِّرۡهُمۡ بِعَذَابٍ اَلِيۡمٍۙ‏"},{"ayah":25,"text":"اِلَّا الَّذِيۡنَ اٰمَنُوۡا وَعَمِلُوا الصّٰلِحٰتِ لَهُمۡ اَجۡرٌ غَيۡرُ مَمۡنُوۡنٍ‏"}]}