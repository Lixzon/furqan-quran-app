{"surah":102,"ayahs":[{"ayah":1,"text":"اَلۡهٰٮكُمُ التَّكَاثُرُۙ‏"},{"ayah":2,"text":"حَتّٰى زُرۡتُمُ الۡمَقَابِرَؕ‏"},{"ayah":3,"text":"كَلَّا سَوۡفَ تَعۡلَمُوۡنَۙ‏"},{"ayah":4,"text":"ثُمَّ كَلَّا سَوۡفَ تَعۡلَمُوۡنَؕ‏"},{"ayah":5,"text":"كَلَّا لَوۡ تَعۡلَمُوۡنَ عِلۡمَ الۡيَقِيۡنِؕ‏"},{"ayah":6,"text":"لَتَرَوُنَّ الۡجَحِيۡمَۙ‏"},{"ayah":7,"text":"ثُمَّ لَتَرَوُنَّهَا عَيۡنَ الۡيَقِيۡنِۙ‏"},{"ayah":8,"text":"ثُمَّ لَـتُسۡـَٔـلُنَّ يَوۡمَٮِٕذٍ عَنِ النَّعِيۡمِ‏"}]}