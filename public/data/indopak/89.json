{"surah":89,"ayahs":[{"ayah":1,"text":"وَالۡفَجۡرِۙ‏"},{"ayah":2,"text":"وَلَيَالٍ عَشۡرٍۙ‏"},{"ayah":3,"text":"وَّالشَّفۡعِ وَالۡوَتۡرِۙ‏"},{"ayah":4,"text":"وَالَّيۡلِ اِذَا يَسۡرِ​ۚ‏"},{"ayah":5,"text":"هَلۡ فِىۡ ذٰلِكَ قَسَمٌ لِّذِىۡ حِجۡرٍؕ‏"},{"ayah":6,"text":"اَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِعَادٍۙ‏"},{"ayah":7,"text":"اِرَمَ ذَاتِ الۡعِمَادِۙ‏"},{"ayah":8,"text":"الَّتِىۡ لَمۡ يُخۡلَقۡ مِثۡلُهَا فِى الۡبِلَادِۙ‏"},{"ayah":9,"text":"وَثَمُوۡدَ الَّذِيۡنَ جَابُوا الصَّخۡرَ بِالۡوَادِۙ‏"},{"ayah":10,"text":"وَفِرۡعَوۡنَ ذِى الۡاَوۡتَادِۙ‏"},{"ayah":11,"text":"الَّذِيۡنَ طَغَوۡا فِى الۡبِلَادِۙ‏"},{"ayah":12,"text":"فَاَكۡثَرُوۡا فِيۡهَا الۡفَسَادَۙ‏"},{"ayah":13,"text":"فَصَبَّ عَلَيۡهِمۡ رَبُّكَ سَوۡطَ عَذَابٍ ۙۚ‏"},{"ayah":14,"text":"اِنَّ رَبَّكَ لَبِالۡمِرۡصَادِؕ‏"},{"ayah":15,"text":"فَاَمَّا الۡاِنۡسَانُ اِذَا مَا ابۡتَلٰٮهُ رَبُّهٗ فَاَكۡرَمَهٗ وَنَعَّمَهٗ  ۙ فَيَقُوۡلُ رَبِّىۡۤ اَكۡرَمَنِؕ‏"},{"ayah":16,"text":"وَاَمَّاۤ اِذَا مَا ابۡتَلٰٮهُ فَقَدَرَ عَلَيۡهِ رِزۡقَهٗ ۙ فَيَقُوۡلُ رَبِّىۡۤ اَهَانَنِ​ۚ‏"},{"ayah":17,"text":"كَلَّا​ بَلۡ لَّا تُكۡرِمُوۡنَ الۡيَتِيۡمَۙ‏"},{"ayah":18,"text":"وَلَا تَحٰٓضُّوۡنَ عَلٰى طَعَامِ الۡمِسۡكِيۡنِۙ‏"},{"ayah":19,"text":"وَتَاۡكُلُوۡنَ التُّرَاثَ اَكۡلًا لَّـمًّا ۙ‏"},{"ayah":20,"text":"وَّتُحِبُّوۡنَ الۡمَالَ حُبًّا جَمًّا ؕ‏"},{"ayah":21,"text":"كَلَّاۤ اِذَا دُكَّتِ الۡاَرۡضُ دَكًّا دَكًّا ۙ‏"},{"ayah":22,"text":"وَّجَآءَ رَبُّكَ وَالۡمَلَكُ صَفًّا صَفًّا ۚ‏"},{"ayah":23,"text":"وَجِاىْٓءَ يَوۡمَٮِٕذٍۢ بِجَهَنَّمَ  ۙ​ يَوۡمَٮِٕذٍ يَّتَذَكَّرُ الۡاِنۡسَانُ وَاَنّٰى لَـهُ الذِّكۡرٰىؕ‏"},{"ayah":24,"text":"يَقُوۡلُ يٰلَيۡتَنِىۡ قَدَّمۡتُ لِحَـيَاتِى​ۚ‏"},{"ayah":25,"text":"فَيَوۡمَٮِٕذٍ لَّا يُعَذِّبُ عَذَابَهٗۤ اَحَدٌ ۙ‏"},{"ayah":26,"text":"وَّلَا يُوۡثِقُ وَثَاقَهٗۤ اَحَدٌ ؕ‏"},{"ayah":27,"text":"يٰۤاَيَّتُهَا النَّفۡسُ الۡمُطۡمَٮِٕنَّةُ  ۖ‏"},{"ayah":28,"text":"ارۡجِعِىۡۤ اِلٰى رَبِّكِ رَاضِيَةً مَّرۡضِيَّةً​ ۚ‏"},{"ayah":29,"text":"فَادۡخُلِىۡ فِىۡ عِبٰدِىۙ‏"},{"ayah":30,"text":"وَادۡخُلِىۡ جَنَّتِى‏"}]}