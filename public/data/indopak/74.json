{"surah":74,"ayahs":[{"ayah":1,"text":"يٰۤاَيُّهَا الۡمُدَّثِّرُۙ‏"},{"ayah":2,"text":"قُمۡ فَاَنۡذِرۡۙ‏"},{"ayah":3,"text":"وَرَبَّكَ فَكَبِّرۡۙ‏"},{"ayah":4,"text":"وَثِيَابَكَ فَطَهِّرۡۙ‏"},{"ayah":5,"text":"وَالرُّجۡزَ فَاهۡجُرۡۙ‏"},{"ayah":6,"text":"وَلَا تَمۡنُنۡ تَسۡتَكۡثِرُۙ‏"},{"ayah":7,"text":"وَ لِرَبِّكَ فَاصۡبِرۡؕ‏"},{"ayah":8,"text":"فَاِذَا نُقِرَ فِى النَّاقُوۡرِۙ‏"},{"ayah":9,"text":"فَذٰلِكَ يَوۡمَٮِٕذٍ يَّوۡمٌ عَسِيۡرٌۙ‏"},{"ayah":10,"text":"عَلَى الۡكٰفِرِيۡنَ غَيۡرُ يَسِيۡرٍ‏"},{"ayah":11,"text":"ذَرۡنِىۡ وَمَنۡ خَلَقۡتُ وَحِيۡدًا ۙ‏"},{"ayah":12,"text":"وَّجَعَلۡتُ لَهٗ مَالًا مَّمۡدُوۡدًا ۙ‏"},{"ayah":13,"text":"وَّبَنِيۡنَ شُهُوۡدًا ۙ‏"},{"ayah":14,"text":"وَّمَهَّدتُّ لَهٗ تَمۡهِيۡدًا ۙ‏"},{"ayah":15,"text":"ثُمَّ يَطۡمَعُ اَنۡ اَزِيۡدَ  ۙ‏"},{"ayah":16,"text":"كَلَّا ؕ اِنَّهٗ كَانَ لِاٰيٰتِنَا عَنِيۡدًا ؕ‏"},{"ayah":17,"text":"سَاُرۡهِقُهٗ صَعُوۡدًا ؕ‏"},{"ayah":18,"text":"اِنَّهٗ فَكَّرَ وَقَدَّرَۙ‏"},{"ayah":19,"text":"فَقُتِلَ كَيۡفَ قَدَّرَۙ‏"},{"ayah":20,"text":"ثُمَّ قُتِلَ كَيۡفَ قَدَّرَۙ‏"},{"ayah":21,"text":"ثُمَّ نَظَرَۙ‏"},{"ayah":22,"text":"ثُمَّ عَبَسَ وَبَسَرَۙ‏"},{"ayah":23,"text":"ثُمَّ اَدۡبَرَ وَاسۡتَكۡبَرَۙ‏"},{"ayah":24,"text":"فَقَالَ اِنۡ هٰذَاۤ اِلَّا سِحۡرٌ يُّؤۡثَرُۙ‏"},{"ayah":25,"text":"اِنۡ هٰذَاۤ اِلَّا قَوۡلُ الۡبَشَرِؕ‏"},{"ayah":26,"text":"سَاُصۡلِيۡهِ سَقَرَ‏"},{"ayah":27,"text":"وَمَاۤ اَدۡرٰٮكَ مَا سَقَرُؕ‏"},{"ayah":28,"text":"لَا تُبۡقِىۡ وَ لَا تَذَرُ​ۚ‏"},{"ayah":29,"text":"لَـوَّاحَةٌ لِّلۡبَشَرِ​ۖ​ۚ‏"},{"ayah":30,"text":"عَلَيۡهَا تِسۡعَةَ عَشَرَؕ‏"},{"ayah":31,"text":"وَمَا جَعَلۡنَاۤ اَصۡحٰبَ النَّارِ اِلَّا مَلٰٓٮِٕكَةً​ وَّمَا جَعَلۡنَا عِدَّتَهُمۡ اِلَّا فِتۡنَةً لِّلَّذِيۡنَ كَفَرُوۡا ۙ لِيَسۡتَيۡقِنَ الَّذِيۡنَ اُوۡتُوا الۡكِتٰبَ وَيَزۡدَادَ الَّذِيۡنَ اٰمَنُوۡۤا اِيۡمَانًا​ وَّلَا يَرۡتَابَ الَّذِيۡنَ اُوۡتُوا الۡكِتٰبَ وَالۡمُؤۡمِنُوۡنَ​ۙ وَلِيَقُوۡلَ الَّذِيۡنَ فِىۡ قُلُوۡبِهِمۡ مَّرَضٌ وَّالۡكٰفِرُوۡنَ مَاذَاۤ اَرَادَ اللّٰهُ بِهٰذَا مَثَلًا ​ؕ كَذٰلِكَ يُضِلُّ اللّٰهُ مَنۡ يَّشَآءُ وَيَهۡدِىۡ مَنۡ يَّشَآءُ ​ؕ وَمَا يَعۡلَمُ جُنُوۡدَ رَبِّكَ اِلَّا هُوَ ​ؕ وَمَا هِىَ اِلَّا ذِكۡرٰى لِلۡبَشَرِ‏"},{"ayah":32,"text":"كَلَّا وَالۡقَمَرِۙ‏"},{"ayah":33,"text":"وَالَّيۡلِ اِذۡ اَدۡبَرَۙ‏"},{"ayah":34,"text":"وَالصُّبۡحِ اِذَاۤ اَسۡفَرَۙ‏"},{"ayah":35,"text":"اِنَّهَا لَاِحۡدَى الۡكُبَرِۙ‏"},{"ayah":36,"text":"نَذِيۡرًا لِّلۡبَشَرِۙ‏"},{"ayah":37,"text":"لِمَنۡ شَآءَ مِنۡكُمۡ اَنۡ يَّتَقَدَّمَ اَوۡ يَتَاَخَّرَؕ‏"},{"ayah":38,"text":"كُلُّ نَفۡسٍ ۢ بِمَا كَسَبَتۡ رَهِيۡنَةٌ ۙ‏"},{"ayah":39,"text":"اِلَّاۤ اَصۡحٰبَ الۡيَمِيۡنِۛ ؕ‏"},{"ayah":40,"text":"فِىۡ جَنّٰتٍ ۛ يَتَسَآءَلُوۡنَۙ‏"},{"ayah":41,"text":"عَنِ الۡمُجۡرِمِيۡنَۙ‏"},{"ayah":42,"text":"مَا سَلَـكَكُمۡ فِىۡ سَقَرَ‏"},{"ayah":43,"text":"قَالُوۡا لَمۡ نَكُ مِنَ الۡمُصَلِّيۡنَۙ‏"},{"ayah":44,"text":"وَلَمۡ نَكُ نُطۡعِمُ الۡمِسۡكِيۡنَۙ‏"},{"ayah":45,"text":"وَكُنَّا نَخُوۡضُ مَعَ الۡخَـآٮِٕضِيۡنَۙ‏"},{"ayah":46,"text":"وَ كُنَّا نُكَذِّبُ بِيَوۡمِ الدِّيۡنِۙ‏"},{"ayah":47,"text":"حَتّٰٓى اَتٰٮنَا الۡيَقِيۡنُؕ‏"},{"ayah":48,"text":"فَمَا تَنۡفَعُهُمۡ شَفَاعَةُ الشّٰفِعِيۡنَؕ‏"},{"ayah":49,"text":"فَمَا لَهُمۡ عَنِ التَّذۡكِرَةِ مُعۡرِضِيۡنَۙ‏"},{"ayah":50,"text":"كَاَنَّهُمۡ حُمُرٌ مُّسۡتَنۡفِرَةٌ ۙ‏"},{"ayah":51,"text":"فَرَّتۡ مِنۡ قَسۡوَرَةٍ ؕ‏"},{"ayah":52,"text":"بَلۡ يُرِيۡدُ كُلُّ امۡرِىٴٍ مِّنۡهُمۡ اَنۡ يُّؤۡتٰى صُحُفًا مُّنَشَّرَةً ۙ‏"},{"ayah":53,"text":"كَلَّا ​ؕ بَلۡ لَّا يَخَافُوۡنَ الۡاٰخِرَةَ ؕ‏"},{"ayah":54,"text":"كَلَّاۤ اِنَّهٗ تَذۡكِرَةٌ​ ۚ‏"},{"ayah":55,"text":"فَمَنۡ شَآءَ ذَكَرَهٗ ؕ‏"},{"ayah":56,"text":"وَمَا يَذۡكُرُوۡنَ اِلَّاۤ اَنۡ يَّشَآءَ اللّٰهُ​ ؕ هُوَ اَهۡلُ التَّقۡوٰى وَاَهۡلُ الۡمَغۡفِرَةِ‏"}]}