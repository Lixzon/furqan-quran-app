{"surah":92,"ayahs":[{"ayah":1,"text":"وَالَّيۡلِ اِذَا يَغۡشٰىۙ‏"},{"ayah":2,"text":"وَالنَّهَارِ اِذَا تَجَلّٰىۙ‏"},{"ayah":3,"text":"وَمَا خَلَقَ الذَّكَرَ وَالۡاُنۡثٰٓىۙ‏"},{"ayah":4,"text":"اِنَّ سَعۡيَكُمۡ لَشَتّٰىؕ‏"},{"ayah":5,"text":"فَاَمَّا مَنۡ اَعۡطٰى وَاتَّقٰىۙ‏"},{"ayah":6,"text":"وَصَدَّقَ بِالۡحُسۡنٰىۙ‏"},{"ayah":7,"text":"فَسَنُيَسِّرُهٗ لِلۡيُسۡرٰىؕ‏"},{"ayah":8,"text":"وَاَمَّا مَنۡۢ بَخِلَ وَاسۡتَغۡنٰىۙ‏"},{"ayah":9,"text":"وَكَذَّبَ بِالۡحُسۡنٰىۙ‏"},{"ayah":10,"text":"فَسَنُيَسِّرُهٗ لِلۡعُسۡرٰىؕ‏"},{"ayah":11,"text":"وَمَا يُغۡنِىۡ عَنۡهُ مَالُهٗۤ اِذَا تَرَدّٰىؕ‏"},{"ayah":12,"text":"اِنَّ عَلَيۡنَا لَـلۡهُدٰىۖ‏"},{"ayah":13,"text":"وَاِنَّ لَـنَا لَـلۡاٰخِرَةَ وَالۡاُوۡلٰى‏"},{"ayah":14,"text":"فَاَنۡذَرۡتُكُمۡ نَارًا تَلَظّٰى​ۚ‏"},{"ayah":15,"text":"لَا يَصۡلٰٮهَاۤ اِلَّا الۡاَشۡقَىۙ‏"},{"ayah":16,"text":"الَّذِىۡ كَذَّبَ وَتَوَلّٰىؕ‏"},{"ayah":17,"text":"وَسَيُجَنَّبُهَا الۡاَتۡقَىۙ‏"},{"ayah":18,"text":"الَّذِىۡ يُؤۡتِىۡ مَالَهٗ يَتَزَكّٰى​ۚ‏"},{"ayah":19,"text":"وَمَا لِاَحَدٍ عِنۡدَهٗ مِنۡ نِّعۡمَةٍ تُجۡزٰٓىۙ‏"},{"ayah":20,"text":"اِلَّا ابۡتِغَآءَ وَجۡهِ رَبِّهِ الۡاَعۡلٰى​ۚ‏"},{"ayah":21,"text":"وَلَسَوۡفَ يَرۡضٰى‏"}]}