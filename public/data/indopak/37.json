{"surah":37,"ayahs":[{"ayah":1,"text":"وَالصّٰٓفّٰتِ صَفًّا ۙ‏"},{"ayah":2,"text":"فَالزّٰجِرٰتِ زَجۡرًا ۙ‏"},{"ayah":3,"text":"فَالتّٰلِيٰتِ ذِكۡرًا ۙ‏"},{"ayah":4,"text":"اِنَّ اِلٰهَكُمۡ لَوَاحِدٌ ؕ‏"},{"ayah":5,"text":"رَبُّ السَّمٰوٰتِ وَالۡاَرۡضِ وَمَا بَيۡنَهُمَا وَرَبُّ الۡمَشَارِقِ ؕ‏"},{"ayah":6,"text":"اِنَّا زَيَّنَّا السَّمَآءَ الدُّنۡيَا بِزِيۡنَةِ اۨلۡكَوَاكِبِۙ‏"},{"ayah":7,"text":"وَحِفۡظًا مِّنۡ كُلِّ شَيۡطٰنٍ مَّارِدٍ​ۚ‏"},{"ayah":8,"text":"لَّا يَسَّمَّعُوۡنَ اِلَى الۡمَلَاِ الۡاَعۡلٰى وَيُقۡذَفُوۡنَ مِنۡ كُلِّ جَانِبٍۖ ‏"},{"ayah":9,"text":"دُحُوۡرًا  وَّلَهُمۡ عَذَابٌ وَّاصِبٌ  ۙ‏"},{"ayah":10,"text":"اِلَّا مَنۡ خَطِفَ الۡخَطۡفَةَ فَاَتۡبَعَهٗ شِهَابٌ ثَاقِبٌ‏"},{"ayah":11,"text":"فَاسۡتَفۡتِهِمۡ اَهُمۡ اَشَدُّ خَلۡقًا اَمۡ مَّنۡ خَلَقۡنَاؕ اِنَّا خَلَقۡنٰهُمۡ مِّنۡ طِيۡنٍ لَّازِبٍ‏"},{"ayah":12,"text":"بَلۡ عَجِبۡتَ وَيَسۡخَرُوۡنَ‏"},{"ayah":13,"text":"وَاِذَا ذُكِّرُوۡا لَا يَذۡكُرُوۡنَ‏"},{"ayah":14,"text":"وَاِذَا رَاَوۡا اٰيَةً يَّسۡتَسۡخِرُوۡنَ‏"},{"ayah":15,"text":"وَقَالُوۡۤا اِنۡ هٰذَاۤ اِلَّا سِحۡرٌ مُّبِيۡنٌ​ ۖ​ۚ‏"},{"ayah":16,"text":"ءَاِذَا مِتۡنَا وَكُـنَّا تُرَابًا وَّعِظَامًا ءَاِنَّا لَمَبۡعُوۡثُوۡنَۙ‏"},{"ayah":17,"text":"اَوَاٰبَآؤُنَا الۡاَوَّلُوۡنَؕ‏"},{"ayah":18,"text":"قُلۡ نَعَمۡ وَاَنۡـتُمۡ دٰخِرُوۡنَ​ۚ‏"},{"ayah":19,"text":"فَاِنَّمَا هِىَ زَجۡرَةٌ وَّاحِدَةٌ فَاِذَا هُمۡ يَنۡظُرُوۡنَ‏"},{"ayah":20,"text":"وَقَالُوۡا يٰوَيۡلَنَا هٰذَا يَوۡمُ الدِّيۡنِ‏"},{"ayah":21,"text":"هٰذَا يَوۡمُ الۡفَصۡلِ الَّذِىۡ كُنۡتُمۡ بِهٖ تُكَذِّبُوۡنَ‏"},{"ayah":22,"text":"اُحۡشُرُوا الَّذِيۡنَ ظَلَمُوۡا وَاَزۡوَاجَهُمۡ وَمَا كَانُوۡا يَعۡبُدُوۡنَۙ‏"},{"ayah":23,"text":"مِنۡ دُوۡنِ اللّٰهِ فَاهۡدُوۡهُمۡ اِلٰى صِرَاطِ الۡجَحِيۡمِ‏"},{"ayah":24,"text":"وَقِفُوۡهُمۡ​ اِنَّهُمۡ مَّسْـُٔـوۡلُوۡنَۙ‏"},{"ayah":25,"text":"مَا لَـكُمۡ لَا تَنَاصَرُوۡنَ‏"},{"ayah":26,"text":"بَلۡ هُمُ الۡيَوۡمَ مُسۡتَسۡلِمُوۡنَ‏"},{"ayah":27,"text":"وَاَقۡبَلَ بَعۡضُهُمۡ عَلٰى بَعۡضٍ يَّتَسَآءَلُوۡنَ‏"},{"ayah":28,"text":"قَالُوۡۤا اِنَّكُمۡ كُنۡتُمۡ تَاۡتُوۡنَنَا عَنِ الۡيَمِيۡنِ‏"},{"ayah":29,"text":"قَالُوۡا بَلْ لَّمۡ تَكُوۡنُوۡا مُؤۡمِنِيۡنَ​ۚ‏"},{"ayah":30,"text":"وَمَا كَانَ لَنَا عَلَيۡكُمۡ مِّنۡ سُلۡطٰنِ​ۚ بَلۡ كُنۡتُمۡ قَوۡمًا طٰغِيۡنَ‏"},{"ayah":31,"text":"فَحَقَّ عَلَيۡنَا قَوۡلُ رَبِّنَآ ۖ اِنَّا لَذَآٮِٕقُوۡنَ‏"},{"ayah":32,"text":"فَاَغۡوَيۡنٰكُمۡ اِنَّا كُنَّا غٰوِيۡنَ‏"},{"ayah":33,"text":"فَاِنَّهُمۡ يَوۡمَٮِٕذٍ فِى الۡعَذَابِ مُشۡتَرِكُوۡنَ‏"},{"ayah":34,"text":"اِنَّا كَذٰلِكَ نَفۡعَلُ بِالۡمُجۡرِمِيۡنَ‏"},{"ayah":35,"text":"اِنَّهُمۡ كَانُوۡۤا اِذَا قِيۡلَ لَهُمۡ لَاۤ اِلٰهَ اِلَّا اللّٰهُۙ يَسۡتَكۡبِرُوۡنَۙ‏"},{"ayah":36,"text":"وَيَقُوۡلُوۡنَ اَٮِٕنَّا لَتٰرِكُوۡۤا اٰلِهَـتِنَا لِشَاعِرٍ مَّجۡـنُوۡنٍ ؕ‏"},{"ayah":37,"text":"بَلۡ جَآءَ بِالۡحَقِّ وَصَدَّقَ الۡمُرۡسَلِيۡنَ‏"},{"ayah":38,"text":"اِنَّكُمۡ لَذَآٮِٕقُوا الۡعَذَابِ الۡاَلِيۡمِ​ۚ‏"},{"ayah":39,"text":"وَمَا تُجۡزَوۡنَ اِلَّا مَا كُنۡتُمۡ تَعۡمَلُوۡنَۙ‏"},{"ayah":40,"text":"اِلَّا عِبَادَ اللّٰهِ الۡمُخۡلَصِيۡنَ‏"},{"ayah":41,"text":"اُولٰٓٮِٕكَ لَهُمۡ رِزۡقٌ مَّعۡلُوۡمٌۙ‏"},{"ayah":42,"text":"فَوَاكِهُ​ۚ وَهُمۡ مُّكۡرَمُوۡنَۙ‏"},{"ayah":43,"text":"فِىۡ جَنّٰتِ النَّعِيۡمِۙ‏"},{"ayah":44,"text":"عَلٰى سُرُرٍ مُّتَقٰبِلِيۡنَ‏"},{"ayah":45,"text":"يُطَافُ عَلَيۡهِمۡ بِكَاۡسٍ مِّنۡ مَّعِيۡنٍۢ ۙ‏"},{"ayah":46,"text":"بَيۡضَآءَ لَذَّةٍ لِّلشّٰرِبِيۡنَ​ ۖ​ۚ‏"},{"ayah":47,"text":"لَا فِيۡهَا غَوۡلٌ وَّلَا هُمۡ عَنۡهَا يُنۡزَفُوۡنَ‏"},{"ayah":48,"text":"وَعِنۡدَهُمۡ قٰصِرٰتُ الطَّرۡفِ عِيۡنٌۙ‏"},{"ayah":49,"text":"كَاَنَّهُنَّ بَيۡضٌ مَّكۡنُوۡنٌ‏"},{"ayah":50,"text":"فَاَقۡبَلَ بَعۡضُهُمۡ عَلٰى بَعۡضٍ يَّتَسَآءَلُوۡنَ‏"},{"ayah":51,"text":"قَالَ قَآٮِٕلٌ مِّنۡهُمۡ اِنِّىۡ كَانَ لِىۡ قَرِيۡنٌۙ‏"},{"ayah":52,"text":"يَقُوۡلُ اَءِ نَّكَ لَمِنَ الۡمُصَدِّقِيۡنَ‏"},{"ayah":53,"text":"ءَاِذَا مِتۡنَا وَكُنَّا تُرَابًا وَّعِظَامًا ءَاِنَّا لَمَدِيۡنُوۡنَ‏"},{"ayah":54,"text":"قَالَ هَلۡ اَنۡتُمۡ مُّطَّلِعُوۡنَ‏"},{"ayah":55,"text":"فَاطَّلَعَ فَرَاٰهُ فِىۡ سَوَآءِ الۡجَحِيۡمِ‏"},{"ayah":56,"text":"قَالَ تَاللّٰهِ اِنۡ كِدْتَّ لَـتُرۡدِيۡنِۙ‏"},{"ayah":57,"text":"وَلَوۡلَا نِعۡمَةُ رَبِّىۡ لَـكُنۡتُ مِنَ الۡمُحۡضَرِيۡنَ‏"},{"ayah":58,"text":"اَفَمَا نَحۡنُ بِمَيِّتِيۡنَۙ‏"},{"ayah":59,"text":"اِلَّا مَوۡتَتَـنَا الۡاُوۡلٰى وَمَا نَحۡنُ بِمُعَذَّبِيۡنَ‏"},{"ayah":60,"text":"اِنَّ هٰذَا لَهُوَ الۡفَوۡزُ الۡعَظِيۡمُ‏"},{"ayah":61,"text":"لِمِثۡلِ هٰذَا فَلۡيَعۡمَلِ الۡعٰمِلُوۡنَ‏"},{"ayah":62,"text":"اَذٰ لِكَ خَيۡرٌ نُّزُلًا اَمۡ شَجَرَةُ الزَّقُّوۡمِ‏"},{"ayah":63,"text":"اِنَّا جَعَلۡنٰهَا فِتۡنَةً لِّلظّٰلِمِيۡنَ‏"},{"ayah":64,"text":"اِنَّهَا شَجَرَةٌ تَخۡرُجُ فِىۡۤ اَصۡلِ الۡجَحِيۡمِۙ‏"},{"ayah":65,"text":"طَلۡعُهَا كَاَنَّهٗ رُءُوۡسُ الشَّيٰطِيۡنِ‏"},{"ayah":66,"text":"فَاِنَّهُمۡ لَاٰكِلُوۡنَ مِنۡهَا فَمٰلِــُٔــوۡنَ مِنۡهَا الۡبُطُوۡنَ ؕ‏"},{"ayah":67,"text":"ثُمَّ اِنَّ لَهُمۡ عَلَيۡهَا لَشَوۡبًا مِّنۡ حَمِيۡمٍ​ۚ‏"},{"ayah":68,"text":"ثُمَّ اِنَّ مَرۡجِعَهُمۡ لَا۟اِلَى الۡجَحِيۡمِ‏"},{"ayah":69,"text":"اِنَّهُمۡ اَلۡفَوۡا اٰبَآءَهُمۡ ضَآلِّيۡنَۙ‏"},{"ayah":70,"text":"فَهُمۡ عَلٰٓى اٰثٰرِهِمۡ يُهۡرَعُوۡنَ‏"},{"ayah":71,"text":"وَلَـقَدۡ ضَلَّ قَبۡلَهُمۡ اَكۡثَرُ الۡاَوَّلِيۡنَۙ‏"},{"ayah":72,"text":"وَلَقَدۡ اَرۡسَلۡنَا فِيۡهِمۡ مُّنۡذِرِيۡنَ‏"},{"ayah":73,"text":"فَانْظُرۡ كَيۡفَ كَانَ عَاقِبَةُ الۡمُنۡذَرِيۡنَۙ‏"},{"ayah":74,"text":"اِلَّا عِبَادَ اللّٰهِ الۡمُخۡلَصِيۡنَ‏"},{"ayah":75,"text":"وَلَقَدۡ نَادٰٮنَا نُوۡحٌ فَلَنِعۡمَ الۡمُجِيۡبُوۡنَ  ۖ‏"},{"ayah":76,"text":"وَنَجَّيۡنٰهُ وَاَهۡلَهٗ مِنَ الۡكَرۡبِ الۡعَظِيۡمِ  ۖ‏"},{"ayah":77,"text":"وَجَعَلۡنَا ذُرِّيَّتَهٗ هُمُ الۡبٰقِيۡنَ  ۖ‏"},{"ayah":78,"text":"وَتَرَكۡنَا عَلَيۡهِ فِى الۡاٰخِرِيۡنَ  ۖ‏"},{"ayah":79,"text":"سَلٰمٌ عَلٰى نُوۡحٍ فِى الۡعٰلَمِيۡنَ‏"},{"ayah":80,"text":"اِنَّا كَذٰلِكَ نَجۡزِى الۡمُحۡسِنِيۡنَ‏"},{"ayah":81,"text":"اِنَّهٗ مِنۡ عِبَادِنَا الۡمُؤۡمِنِيۡنَ‏"},{"ayah":82,"text":"ثُمَّ اَغۡرَقۡنَا الۡاٰخَرِيۡنَ‏"},{"ayah":83,"text":"وَاِنَّ مِنۡ شِيۡعَتِهٖ لَاِبۡرٰهِيۡمَ​ۘ‏"},{"ayah":84,"text":"اِذۡ جَآءَ رَبَّهٗ بِقَلۡبٍ سَلِيۡمٍ‏"},{"ayah":85,"text":"اِذۡ قَالَ لِاَبِيۡهِ وَقَوۡمِهٖ مَاذَا تَعۡبُدُوۡنَ​ۚ‏"},{"ayah":86,"text":"اَٮِٕفۡكًا اٰلِهَةً دُوۡنَ اللّٰهِ تُرِيۡدُوۡنَؕ‏"},{"ayah":87,"text":"فَمَا ظَنُّكُمۡ بِرَبِّ الۡعٰلَمِيۡنَ‏"},{"ayah":88,"text":"فَنَظَرَ نَظۡرَةً فِى النُّجُوۡمِۙ‏"},{"ayah":89,"text":"فَقَالَ اِنِّىۡ سَقِيۡمٌ‏"},{"ayah":90,"text":"فَتَوَلَّوۡا عَنۡهُ مُدۡبِرِيۡنَ‏"},{"ayah":91,"text":"فَرَاغَ اِلٰٓى اٰلِهَتِهِمۡ فَقَالَ اَلَا تَاۡكُلُوۡنَ​ۚ‏"},{"ayah":92,"text":"مَا لَـكُمۡ لَا تَنۡطِقُوۡنَ‏"},{"ayah":93,"text":"فَرَاغَ عَلَيۡهِمۡ ضَرۡبًۢا بِالۡيَمِيۡنِ‏"},{"ayah":94,"text":"فَاَقۡبَلُوۡۤا اِلَيۡهِ يَزِفُّوۡنَ‏"},{"ayah":95,"text":"قَالَ اَتَعۡبُدُوۡنَ مَا تَنۡحِتُوۡنَۙ‏"},{"ayah":96,"text":"وَاللّٰهُ خَلَقَكُمۡ وَمَا تَعۡمَلُوۡنَ‏"},{"ayah":97,"text":"قَالُوا ابۡنُوۡا لَهٗ بُنۡيَانًا فَاَلۡقُوۡهُ فِى الۡجَحِيۡمِ‏"},{"ayah":98,"text":"فَاَرَادُوۡا بِهٖ كَيۡدًا فَجَعَلۡنٰهُمُ الۡاَسۡفَلِيۡنَ‏"},{"ayah":99,"text":"وَقَالَ اِنِّىۡ ذَاهِبٌ اِلٰى رَبِّىۡ سَيَهۡدِيۡنِ‏"},{"ayah":100,"text":"رَبِّ هَبۡ لِىۡ مِنَ الصّٰلِحِيۡنَ‏"},{"ayah":101,"text":"فَبَشَّرۡنٰهُ بِغُلٰمٍ حَلِيۡمٍ‏"},{"ayah":102,"text":"فَلَمَّا بَلَغَ مَعَهُ السَّعۡىَ قَالَ يٰبُنَىَّ اِنِّىۡۤ اَرٰى فِى الۡمَنَامِ اَنِّىۡۤ اَذۡبَحُكَ فَانْظُرۡ مَاذَا تَرٰى​ؕ قَالَ يٰۤاَبَتِ افۡعَلۡ مَا تُؤۡمَرُ​ سَتَجِدُنِىۡۤ اِنۡ شَآءَ اللّٰهُ مِنَ الصّٰبِرِيۡنَ‏"},{"ayah":103,"text":"فَلَمَّاۤ اَسۡلَمَا وَتَلَّهٗ لِلۡجَبِيۡنِ​ۚ‏"},{"ayah":104,"text":"وَنَادَيۡنٰهُ اَنۡ يّٰۤاِبۡرٰهِيۡمُۙ‏"},{"ayah":105,"text":"قَدۡ صَدَّقۡتَ الرُّءۡيَا ​ ​ۚ اِنَّا كَذٰلِكَ نَجۡزِى الۡمُحۡسِنِيۡنَ‏"},{"ayah":106,"text":"اِنَّ هٰذَا لَهُوَ الۡبَلٰٓؤُا الۡمُبِيۡنُ‏"},{"ayah":107,"text":"وَفَدَيۡنٰهُ بِذِبۡحٍ عَظِيۡمٍ‏"},{"ayah":108,"text":"وَتَرَكۡنَا عَلَيۡهِ فِى الۡاٰخِرِيۡنَ​ۖ‏"},{"ayah":109,"text":"سَلٰمٌ عَلٰٓى اِبۡرٰهِيۡمَ‏"},{"ayah":110,"text":"كَذٰلِكَ نَجۡزِى الۡمُحۡسِنِيۡنَ‏"},{"ayah":111,"text":"اِنَّهٗ مِنۡ عِبَادِنَا الۡمُؤۡمِنِيۡنَ‏"},{"ayah":112,"text":"وَبَشَّرۡنٰهُ بِاِسۡحٰقَ نَبِيًّا مِّنَ الصّٰلِحِيۡنَ‏"},{"ayah":113,"text":"وَبٰرَكۡنَا عَلَيۡهِ وَعَلٰٓى اِسۡحٰقَ​ؕ وَ مِنۡ ذُرِّيَّتِهِمَا مُحۡسِنٌ وَّظَالِمٌ لِّنَفۡسِهٖ مُبِيۡنٌ​‏"},{"ayah":114,"text":"وَلَقَدۡ مَنَنَّا عَلٰى مُوۡسٰى وَهٰرُوۡنَ​ۚ‏"},{"ayah":115,"text":"وَنَجَّيۡنٰهُمَا وَقَوۡمَهُمَا مِنَ الۡكَرۡبِ الۡعَظِيۡمِ​ۚ‏"},{"ayah":116,"text":"وَنَصَرۡنٰهُمۡ فَكَانُوۡا هُمُ الۡغٰلِبِيۡنَ​ۚ‏"},{"ayah":117,"text":"وَاٰتَيۡنٰهُمَا الۡكِتٰبَ الۡمُسۡتَبِيۡنَ​ۚ‏"},{"ayah":118,"text":"وَهَدَيۡنٰهُمَا الصِّرَاطَ الۡمُسۡتَقِيۡمَ​ۚ‏"},{"ayah":119,"text":"وَتَرَكۡنَا عَلَيۡهِمَا فِى الۡاٰخِرِيۡنَۙ‏"},{"ayah":120,"text":"سَلٰمٌ عَلٰى مُوۡسٰى وَهٰرُوۡنَ‏"},{"ayah":121,"text":"اِنَّا كَذٰلِكَ نَجۡزِى الۡمُحۡسِنِيۡنَ‏"},{"ayah":122,"text":"اِنَّهُمَا مِنۡ عِبَادِنَا الۡمُؤۡمِنِيۡنَ‏"},{"ayah":123,"text":"وَاِنَّ اِلۡيَاسَ لَمِنَ الۡمُرۡسَلِيۡنَؕ‏"},{"ayah":124,"text":"اِذۡ قَالَ لِقَوۡمِهٖۤ اَلَا تَتَّقُوۡنَ‏"},{"ayah":125,"text":"اَتَدۡعُوۡنَ بَعۡلًا وَّتَذَرُوۡنَ اَحۡسَنَ الۡخٰلِقِيۡنَۙ‏"},{"ayah":126,"text":"اللّٰهَ رَبَّكُمۡ وَرَبَّ اٰبَآٮِٕكُمُ الۡاَوَّلِيۡنَ‏"},{"ayah":127,"text":"فَكَذَّبُوۡهُ فَاِنَّهُمۡ لَمُحۡضَرُوۡنَۙ‏"},{"ayah":128,"text":"اِلَّا عِبَادَ اللّٰهِ الۡمُخۡلَصِيۡنَ‏"},{"ayah":129,"text":"وَتَرَكۡنَا عَلَيۡهِ فِى الۡاٰخِرِيۡنَۙ‏"},{"ayah":130,"text":"سَلٰمٌ عَلٰٓى اِلۡ يَاسِيۡنَ‏"},{"ayah":131,"text":"اِنَّا كَذٰلِكَ نَجۡزِى الۡمُحۡسِنِيۡنَ‏"},{"ayah":132,"text":"اِنَّهٗ مِنۡ عِبَادِنَا الۡمُؤۡمِنِيۡنَ‏"},{"ayah":133,"text":"وَاِنَّ لُوۡطًا لَّمِنَ الۡمُرۡسَلِيۡنَؕ‏"},{"ayah":134,"text":"اِذۡ نَجَّيۡنٰهُ وَاَهۡلَهٗۤ اَجۡمَعِيۡنَۙ‏"},{"ayah":135,"text":"اِلَّا عَجُوۡزًا فِى الۡغٰبِرِيۡنَ‏"},{"ayah":136,"text":"ثُمَّ دَمَّرۡنَا الۡاٰخَرِيۡنَ‏"},{"ayah":137,"text":"وَاِنَّكُمۡ لَتَمُرُّوۡنَ عَلَيۡهِمۡ مُّصۡبِحِيۡنَۙ‏"},{"ayah":138,"text":"وَبِالَّيۡلِ​ؕ اَفَلَا تَعۡقِلُوۡنَ​‏"},{"ayah":139,"text":"وَاِنَّ يُوۡنُسَ لَمِنَ الۡمُرۡسَلِيۡنَؕ‏"},{"ayah":140,"text":"اِذۡ اَبَقَ اِلَى الۡفُلۡكِ الۡمَشۡحُوۡنِۙ‏"},{"ayah":141,"text":"فَسَاهَمَ فَكَانَ مِنَ الۡمُدۡحَضِيۡنَ​ۚ‏"},{"ayah":142,"text":"فَالۡتَقَمَهُ الۡحُوۡتُ وَهُوَ مُلِيۡمٌ‏"},{"ayah":143,"text":"فَلَوۡلَاۤ اَنَّهٗ كَانَ مِنَ الۡمُسَبِّحِيۡنَۙ‏"},{"ayah":144,"text":"لَلَبِثَ فِىۡ بَطۡنِهٖۤ اِلٰى يَوۡمِ يُبۡعَثُوۡنَ​ۚ‏"},{"ayah":145,"text":"فَنَبَذۡنٰهُ بِالۡعَرَآءِ وَهُوَ سَقِيۡمٌ​ۚ‏"},{"ayah":146,"text":"وَاَنۡۢبَتۡنَا عَلَيۡهِ شَجَرَةً مِّنۡ يَّقۡطِيۡنٍ​ۚ‏"},{"ayah":147,"text":"وَاَرۡسَلۡنٰهُ اِلٰى مِائَةِ اَلۡفٍ اَوۡ يَزِيۡدُوۡنَ​ۚ‏"},{"ayah":148,"text":"فَاٰمَنُوۡا فَمَتَّعۡنٰهُمۡ اِلٰى حِيۡنٍؕ‏"},{"ayah":149,"text":"فَاسۡتَفۡتِهِمۡ اَلِرَبِّكَ الۡبَنَاتُ وَلَهُمُ الۡبَنُوۡنَۙ‏"},{"ayah":150,"text":"اَمۡ خَلَقۡنَا الۡمَلٰٓٮِٕكَةَ اِنَاثًا وَّهُمۡ شٰهِدُوۡنَ‏"},{"ayah":151,"text":"اَلَاۤ اِنَّهُمۡ مِّنۡ اِفۡكِهِمۡ لَيَقُوۡلُوۡنَۙ‏"},{"ayah":152,"text":"وَلَدَ اللّٰهُۙ وَاِنَّهُمۡ لَـكٰذِبُوۡنَ‏"},{"ayah":153,"text":"اَصۡطَفَى الۡبَنَاتِ عَلَى الۡبَنِيۡنَؕ‏"},{"ayah":154,"text":"مَا لَـكُمۡ كَيۡفَ تَحۡكُمُوۡنَ‏"},{"ayah":155,"text":"اَفَلَا تَذَكَّرُوۡنَ​ۚ‏"},{"ayah":156,"text":"اَمۡ لَـكُمۡ سُلۡطٰنٌ مُّبِيۡنٌۙ‏"},{"ayah":157,"text":"فَاۡتُوۡا بِكِتٰبِكُمۡ اِنۡ كُنۡتُمۡ صٰدِقِيۡنَ‏"},{"ayah":158,"text":"وَجَعَلُوۡا بَيۡنَهٗ وَبَيۡنَ الۡجِنَّةِ نَسَبًا ؕ​ وَلَقَدۡ عَلِمَتِ الۡجِنَّةُ اِنَّهُمۡ لَمُحۡضَرُوۡنَۙ‏"},{"ayah":159,"text":"سُبۡحٰنَ اللّٰهِ عَمَّا يَصِفُوۡنَۙ‏"},{"ayah":160,"text":"اِلَّا عِبَادَ اللّٰهِ الۡمُخۡلَصِيۡنَ‏"},{"ayah":161,"text":"فَاِنَّكُمۡ وَمَا تَعۡبُدُوۡنَۙ‏"},{"ayah":162,"text":"مَاۤ اَنۡـتُمۡ عَلَيۡهِ بِفٰتِنِيۡنَۙ‏"},{"ayah":163,"text":"اِلَّا مَنۡ هُوَ صَالِ الۡجَحِيۡمِ‏"},{"ayah":164,"text":"وَمَا مِنَّاۤ اِلَّا لَهٗ مَقَامٌ مَّعۡلُوۡمٌۙ‏"},{"ayah":165,"text":"وَّاِنَّا لَـنَحۡنُ الصَّآفُّوۡنَ​ۚ‏"},{"ayah":166,"text":"وَاِنَّا لَـنَحۡنُ الۡمُسَبِّحُوۡنَ‏"},{"ayah":167,"text":"وَاِنۡ كَانُوۡا لَيَقُوۡلُوۡنَۙ‏"},{"ayah":168,"text":"لَوۡ اَنَّ عِنۡدَنَا ذِكۡرًا مِّنَ الۡاَوَّلِيۡنَۙ‏"},{"ayah":169,"text":"لَـكُنَّا عِبَادَ اللّٰهِ الۡمُخۡلَصِيۡنَ‏"},{"ayah":170,"text":"فَكَفَرُوۡا بِهٖ​ فَسَوۡفَ يَعۡلَمُوۡنَ‏"},{"ayah":171,"text":"وَلَقَدۡ سَبَقَتۡ كَلِمَتُنَا لِعِبَادِنَا الۡمُرۡسَلِيۡنَ ​ۖ​ۚ‏"},{"ayah":172,"text":"اِنَّهُمۡ لَهُمُ الۡمَنۡصُوۡرُوۡنَ ‏"},{"ayah":173,"text":"وَاِنَّ جُنۡدَنَا لَهُمُ الۡغٰلِبُوۡنَ‏"},{"ayah":174,"text":"فَتَوَلَّ عَنۡهُمۡ حَتّٰى حِيۡنٍۙ‏"},{"ayah":175,"text":"وَاَبۡصِرۡهُمۡ فَسَوۡفَ يُبۡصِرُوۡنَ‏"},{"ayah":176,"text":"اَفَبِعَذَابِنَا يَسۡتَعۡجِلُوۡنَ‏"},{"ayah":177,"text":"فَاِذَا نَزَلَ بِسَاحَتِهِمۡ فَسَآءَ صَبَاحُ الۡمُنۡذَرِيۡنَ‏"},{"ayah":178,"text":"وَتَوَلَّ عَنۡهُمۡ حَتّٰى حِيۡنٍۙ‏"},{"ayah":179,"text":"وَّاَبۡصِرۡ فَسَوۡفَ يُبۡصِرُوۡنَ‏"},{"ayah":180,"text":"سُبۡحٰنَ رَبِّكَ رَبِّ الۡعِزَّةِ عَمَّا يَصِفُوۡنَ​ۚ‏"},{"ayah":181,"text":"وَسَلٰمٌ عَلَى الۡمُرۡسَلِيۡنَ​ۚ‏"},{"ayah":182,"text":"وَالۡحَمۡدُ لِلّٰهِ رَبِّ الۡعٰلَمِيۡنَ​‏"}]}