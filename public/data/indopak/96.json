{"surah":96,"ayahs":[{"ayah":1,"text":"اِقۡرَاۡ بِاسۡمِ رَبِّكَ الَّذِىۡ خَلَقَ​ۚ‏"},{"ayah":2,"text":"خَلَقَ الۡاِنۡسَانَ مِنۡ عَلَقٍ​ۚ‏"},{"ayah":3,"text":"اِقۡرَاۡ وَرَبُّكَ الۡاَكۡرَمُۙ‏"},{"ayah":4,"text":"الَّذِىۡ عَلَّمَ بِالۡقَلَمِۙ‏"},{"ayah":5,"text":"عَلَّمَ الۡاِنۡسَانَ مَا لَمۡ يَعۡلَمۡؕ‏"},{"ayah":6,"text":"كَلَّاۤ اِنَّ الۡاِنۡسَانَ لَيَطۡغٰٓىۙ‏"},{"ayah":7,"text":"اَنۡ رَّاٰهُ اسۡتَغۡنٰىؕ‏"},{"ayah":8,"text":"اِنَّ اِلٰى رَبِّكَ الرُّجۡعٰىؕ‏"},{"ayah":9,"text":"اَرَءَيۡتَ الَّذِىۡ يَنۡهٰىؕ‏"},{"ayah":10,"text":"عَبۡدًا اِذَا صَلّٰىؕ‏"},{"ayah":11,"text":"اَرَءَيۡتَ اِنۡ كَانَ عَلَى الۡهُدٰٓىۙ‏"},{"ayah":12,"text":"اَوۡ اَمَرَ بِالتَّقۡوٰىۙ‏"},{"ayah":13,"text":"اَرَءَيۡتَ اِنۡ كَذَّبَ وَتَوَلّٰىؕ‏"},{"ayah":14,"text":"اَلَمۡ يَعۡلَمۡ بِاَنَّ اللّٰهَ يَرٰىؕ‏"},{"ayah":15,"text":"كَلَّا لَٮِٕنۡ لَّمۡ يَنۡتَهِ  ۙ لَنَسۡفَعًۢا بِالنَّاصِيَةِۙ‏"},{"ayah":16,"text":"نَاصِيَةٍ كَاذِبَةٍ خَاطِئَةٍ​ ۚ‏"},{"ayah":17,"text":"فَلۡيَدۡعُ نَادِيَهٗ ۙ‏"},{"ayah":18,"text":"سَنَدۡعُ الزَّبَانِيَةَ ۙ‏"},{"ayah":19,"text":"كَلَّا ؕ لَا تُطِعۡهُ وَاسۡجُدۡ وَاقۡتَرِبْ۩‏"}]}