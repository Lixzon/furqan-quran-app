{"surah":82,"ayahs":[{"ayah":1,"text":"اِذَا السَّمَآءُ انْفَطَرَتۡۙ‏"},{"ayah":2,"text":"وَاِذَا الۡكَوَاكِبُ انْتَثَرَتۡۙ‏"},{"ayah":3,"text":"وَاِذَا الۡبِحَارُ فُجِّرَتۡۙ‏"},{"ayah":4,"text":"وَاِذَا الۡقُبُوۡرُ بُعۡثِرَتۡۙ‏"},{"ayah":5,"text":"عَلِمَتۡ نَفۡسٌ مَّا قَدَّمَتۡ وَاَخَّرَتۡؕ‏"},{"ayah":6,"text":"يٰۤاَيُّهَا الۡاِنۡسَانُ مَا غَرَّكَ بِرَبِّكَ الۡكَرِيۡمِۙ‏"},{"ayah":7,"text":"الَّذِىۡ خَلَقَكَ فَسَوّٰٮكَ فَعَدَلَـكَۙ‏"},{"ayah":8,"text":"فِىۡۤ اَىِّ صُوۡرَةٍ مَّا شَآءَ رَكَّبَكَؕ‏"},{"ayah":9,"text":"كَلَّا بَلۡ تُكَذِّبُوۡنَ بِالدِّيۡنِۙ‏"},{"ayah":10,"text":"وَاِنَّ عَلَيۡكُمۡ لَحٰـفِظِيۡنَۙ‏"},{"ayah":11,"text":"كِرَامًا كَاتِبِيۡنَۙ‏"},{"ayah":12,"text":"يَعۡلَمُوۡنَ مَا تَفۡعَلُوۡنَ‏"},{"ayah":13,"text":"اِنَّ الۡاَبۡرَارَ لَفِىۡ نَعِيۡمٍۚ‏"},{"ayah":14,"text":"وَاِنَّ الۡفُجَّارَ لَفِىۡ جَحِيۡمٍ ۚۖ‏"},{"ayah":15,"text":"يَّصۡلَوۡنَهَا يَوۡمَ الدِّيۡنِ‏"},{"ayah":16,"text":"وَمَا هُمۡ عَنۡهَا بِغَآٮِٕبِيۡنَؕ‏"},{"ayah":17,"text":"وَمَاۤ اَدۡرٰٮكَ مَا يَوۡمُ الدِّيۡنِۙ‏"},{"ayah":18,"text":"ثُمَّ مَاۤ اَدۡرٰٮكَ مَا يَوۡمُ الدِّيۡنِؕ‏"},{"ayah":19,"text":"يَوۡمَ لَا تَمۡلِكُ نَفۡسٌ لِّنَفۡسٍ شَيۡـــًٔا​ ؕ وَالۡاَمۡرُ يَوۡمَٮِٕذٍ لِّلَّهِ‏"}]}