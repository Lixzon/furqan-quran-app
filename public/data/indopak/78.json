{"surah":78,"ayahs":[{"ayah":1,"text":"عَمَّ يَتَسَآءَلُوۡنَ​ۚ‏"},{"ayah":2,"text":"عَنِ النَّبَاِ الۡعَظِيۡمِۙ‏"},{"ayah":3,"text":"الَّذِىۡ هُمۡ فِيۡهِ مُخۡتَلِفُوۡنَؕ‏"},{"ayah":4,"text":"كَلَّا سَيَعۡلَمُوۡنَۙ‏"},{"ayah":5,"text":"ثُمَّ كَلَّا سَيَعۡلَمُوۡنَ‏"},{"ayah":6,"text":"اَلَمۡ نَجۡعَلِ الۡاَرۡضَ مِهٰدًا ۙ‏"},{"ayah":7,"text":"وَّالۡجِبَالَ اَوۡتَادًا ۙ‏"},{"ayah":8,"text":"وَّخَلَقۡنٰكُمۡ اَزۡوَاجًا ۙ‏"},{"ayah":9,"text":"وَّجَعَلۡنَا نَوۡمَكُمۡ سُبَاتًا ۙ‏"},{"ayah":10,"text":"وَّجَعَلۡنَا الَّيۡلَ لِبَاسًا ۙ‏"},{"ayah":11,"text":"وَّجَعَلۡنَا النَّهَارَ مَعَاشًا‏"},{"ayah":12,"text":"وَّبَنَيۡنَا فَوۡقَكُمۡ سَبۡعًا شِدَادًا ۙ‏"},{"ayah":13,"text":"وَّ جَعَلۡنَا سِرَاجًا وَّهَّاجًا ۙ‏"},{"ayah":14,"text":"وَّاَنۡزَلۡنَا مِنَ الۡمُعۡصِرٰتِ مَآءً ثَجَّاجًا ۙ‏"},{"ayah":15,"text":"لِّـنُخۡرِجَ بِهٖ حَبًّا وَّنَبَاتًا ۙ‏"},{"ayah":16,"text":"وَّجَنّٰتٍ اَلۡفَافًا ؕ‏"},{"ayah":17,"text":"اِنَّ يَوۡمَ الۡفَصۡلِ كَانَ مِيۡقَاتًا ۙ‏"},{"ayah":18,"text":"يَّوۡمَ يُنۡفَخُ فِى الصُّوۡرِ فَتَاۡتُوۡنَ اَفۡوَاجًا ۙ‏"},{"ayah":19,"text":"وَّفُتِحَتِ السَّمَآءُ فَكَانَتۡ اَبۡوَابًا ۙ‏"},{"ayah":20,"text":"وَّ سُيِّرَتِ الۡجِبَالُ فَكَانَتۡ سَرَابًا ؕ‏"},{"ayah":21,"text":"اِنَّ جَهَنَّمَ كَانَتۡ مِرۡصَادًا ۙ‏"},{"ayah":22,"text":"لِّلطّٰغِيۡنَ مَاٰبًا ۙ‏"},{"ayah":23,"text":"لّٰبِثِيۡنَ فِيۡهَاۤ اَحۡقَابًا​ ۚ‏"},{"ayah":24,"text":"لَا يَذُوۡقُوۡنَ فِيۡهَا بَرۡدًا وَّلَا شَرَابًا ۙ‏"},{"ayah":25,"text":"اِلَّا حَمِيۡمًا وَّغَسَّاقًا ۙ‏"},{"ayah":26,"text":"جَزَآءً وِّفَاقًا ؕ‏"},{"ayah":27,"text":"اِنَّهُمۡ كَانُوۡا لَا يَرۡجُوۡنَ حِسَابًا ۙ‏"},{"ayah":28,"text":"وَّكَذَّبُوۡا بِاٰيٰتِنَا كِذَّابًا ؕ‏"},{"ayah":29,"text":"وَكُلَّ شَىۡءٍ اَحۡصَيۡنٰهُ كِتٰبًا ۙ‏"},{"ayah":30,"text":"فَذُوۡقُوۡا فَلَنۡ نَّزِيۡدَكُمۡ اِلَّا عَذَابًا‏"},{"ayah":31,"text":"اِنَّ لِلۡمُتَّقِيۡنَ مَفَازًا ۙ‏"},{"ayah":32,"text":"حَدَآٮِٕقَ وَاَعۡنَابًا ۙ‏"},{"ayah":33,"text":"وَّكَوَاعِبَ اَتۡرَابًا ۙ‏"},{"ayah":34,"text":"وَّكَاۡسًا دِهَاقًا ؕ‏"},{"ayah":35,"text":"لَا يَسۡمَعُوۡنَ فِيۡهَا لَـغۡوًا وَّلَا كِذّٰبًا​ ۚ‏"},{"ayah":36,"text":"جَزَآءً مِّنۡ رَّبِّكَ عَطَآءً حِسَابًا ۙ‏"},{"ayah":37,"text":"رَّبِّ السَّمٰوٰتِ وَالۡاَرۡضِ وَمَا بَيۡنَهُمَا الرَّحۡمٰنِ​ لَا يَمۡلِكُوۡنَ مِنۡهُ خِطَابًا​ ۚ‏"},{"ayah":38,"text":"يَوۡمَ يَقُوۡمُ الرُّوۡحُ وَالۡمَلٰٓٮِٕكَةُ صَفًّا ؕۙ لَّا يَتَكَلَّمُوۡنَ اِلَّا مَنۡ اَذِنَ لَهُ الرَّحۡمٰنُ وَقَالَ صَوَابًا​‏"},{"ayah":39,"text":"ذٰلِكَ الۡيَوۡمُ الۡحَـقُّ​ ۚ فَمَنۡ شَآءَ اتَّخَذَ اِلٰى رَبِّهٖ مَاٰبًا‏"},{"ayah":40,"text":"اِنَّاۤ اَنۡذَرۡنٰـكُمۡ عَذَابًا قَرِيۡبًا ۖۚ  يَّوۡمَ يَنۡظُرُ الۡمَرۡءُ مَا قَدَّمَتۡ يَدٰهُ وَيَقُوۡلُ الۡـكٰفِرُ يٰلَيۡتَنِىۡ كُنۡتُ تُرٰبًا‏"}]}